// HG Capital OS schema.
// Core: Deals, Properties, Contractors, Tasks (v1 migration).
// Financials: a read-only mirror of the QuickBooks Online P&L (QuickbooksConnection …
// LedgerLine). QuickBooks stays the system of record — see /Users/connorswofford/.claude/plans.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the rhel target is the Vercel (AWS Lambda) runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users — 2 trusted internal users (Connor, Pieter). No roles in v1.
// ---------------------------------------------------------------------------
model User {
  id                String        @id @default(cuid())
  email             String        @unique
  name              String?
  // scrypt hash, "<saltHex>.<hashHex>" — see src/lib/password.ts. Null means
  // this user can't sign in yet (no roles/self-signup in v1: rows without a
  // hash are provisioned by hand, then backfilled — see
  // scripts/backfill-password-hashes.ts).
  passwordHash      String?
  // Set by a "Forgot password" reset. A session cookie issued before it no
  // longer signs in (src/lib/auth.ts), so a reset signs the user out everywhere.
  passwordChangedAt DateTime?
  // Connect Claude (docs/specs/tasks-from-claude.md 7.1, D24): this partner's own
  // connector address is <APP_URL>/api/mcp/<key>. The key is never stored: it is
  // rebuilt from claudeKeyId and the session secret (src/lib/claude/oauth-core.ts),
  // and claudeKeyHash is its SHA-256, the lookup for a call to that address. Both
  // null: no address yet, or Disconnect retired it.
  claudeKeyId       String?
  claudeKeyHash     String?       @unique
  // Mail to this partner that isn't getting through, as on PortalAccount below (src/lib/email/delivery-events.ts).
  emailProblem      EmailProblem?
  emailEventAt      DateTime?
  emailEventTo      String?
  createdAt         DateTime      @default(now())

  asanaGid String? @unique // Asana user gid, matched once by the import

  assignedTasks  Task[] @relation("TaskAssignee")
  createdTasks   Task[] @relation("TaskCreatedBy")
  completedTasks Task[] @relation("TaskCompletedByUser")

  taskEvents                  TaskEvent[]
  uploadedAttachments         TaskAttachment[]     @relation("AttachmentUploadedByUser")
  checkedItems                TaskChecklistItem[]  @relation("ChecklistDoneByUser")
  taskReadStates              TaskReadState[]
  grantedTaskAccess           TaskAccess[]
  createdPortalAccounts       PortalAccount[]
  notifications               NotificationOutbox[]
  recentViews                 RecentView[]
  // Who last changed a property or deal, for the conflict line on a save
  // ("Pieter set this to $410,000 at 2:14 PM", forms 2.12).
  updatedProperties           Property[]           @relation("PropertyUpdatedBy")
  updatedDeals                Deal[]               @relation("DealUpdatedBy")
  // Who added a property document, for "Connor · Oct 3" on its row (uploads 2.4).
  uploadedPropertyAttachments PropertyAttachment[] @relation("PropertyAttachmentUploadedBy")
  createdLeases               Lease[]              @relation("LeaseCreatedBy")
  uploadedLeaseFiles          LeaseFile[]          @relation("LeaseFileUploadedBy")
  createdRehabs               Rehab[]              @relation("RehabCreatedBy")
  // Who wrote a deal note, so the deal's Activity names its author instead of
  // initials pasted into the text (activity 2.9, DEALS-044).
  dealNotes                   DealNote[]           @relation("DealNoteAuthor")
  // Who archived a deal, property or contractor, for "Connor archived this on Oct 27."
  archivedDeals               Deal[]               @relation("DealArchivedBy")
  archivedProperties          Property[]           @relation("PropertyArchivedBy")
  archivedContacts            Contact[]            @relation("ContactArchivedBy")
  // A partner's job-email links, which only show that email's photos.
  jobLinks                    JobLink[]            @relation("JobLinkUser")
  // Contractor onboarding (docs/specs/contractor-onboarding.md): invites a partner sent, and a contractor's Keep or Baselane note.
  sentPortalInvites           PortalInvite[]       @relation("PortalInviteCreatedBy")
  uploadedContactDocuments    ContactDocument[]    @relation("ContactDocumentUploadedByUser")
  // Missing info (docs/specs/missing-info.md, D3): the checks a partner said don't apply.
  missingInfoSkips            MissingInfoSkip[]    @relation("MissingInfoSkipBy")

  qboConnections      QuickbooksConnection[]
  // New task's files before Create, and which task each form made (docs/specs/new-task-checklist-photos.md).
  newTaskUploads      NewTaskUpload[]
  newTaskForms        NewTaskForm[]
  // "Forgot password" links for this partner (docs/specs/staff-password-reset.md).
  passwordResetTokens PasswordResetToken[]

  // Contractor invoices (docs/contractor-invoices-plan.md): the ones this partner entered, approved or marked paid.
  createdInvoices   Invoice[]          @relation("InvoiceCreatedByUser")
  approvedInvoices  Invoice[]          @relation("InvoiceApprovedBy")
  paidInvoices      Invoice[]          @relation("InvoicePaidBy")
  invoiceEvents     InvoiceEvent[]     @relation("InvoiceEventActorUser")
  // This partner's Claude, connected through the connector (docs/specs/tasks-from-claude.md).
  claudeConnections ClaudeConnection[]
}

// ---------------------------------------------------------------------------
// Deals — from the "Prospective Deals" tab (~748 rows).
// ---------------------------------------------------------------------------
model Deal {
  id      String @id @default(cuid())
  address String

  // Prices: parsed numbers where possible, raw text always preserved.
  theirPrice    Decimal? @db.Decimal(12, 2)
  theirPriceRaw String?
  ourPrice      Decimal? @db.Decimal(12, 2) // HG's target offer ("Target offer" in the UI)
  ourPriceRaw   String?
  currentOffer  Decimal? @db.Decimal(12, 2)

  units Int?
  beds  String?
  baths String?
  sqft  Int?
  taxes Decimal? @db.Decimal(12, 2)

  status     String  @default("Active") // configurable list in src/lib/config.ts
  priority   String? // "1 - High", etc.
  vip        Boolean @default(false)
  passReason String?

  sourceUrl String?
  links     Json    @default("[]") // [{ label, url }]

  nextAction    String?
  nextActionDue DateTime?

  rawLatestUpdates String? @db.Text // verbatim from the spreadsheet cell

  convertedProperty   Property? @relation("DealToProperty", fields: [convertedPropertyId], references: [id])
  convertedPropertyId String?   @unique

  notes DealNote[]
  tasks Task[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Who made the last change (patchDeal, createDeal), so a conflict names them. Null on
  // rows from before it was recorded, and when that user is deleted.
  updatedByUser   User?    @relation("DealUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?

  // Archived (src/lib/archive.ts): out of every list, count, search and picker, with its
  // history kept, until Restore clears both. Who did it, for the record's line; null on a
  // live deal, and when that user is deleted.
  archivedAt       DateTime?
  archivedByUser   User?     @relation("DealArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  archivedByUserId String?

  @@index([status])
  @@index([address])
}

// Parsed timeline from the "Latest Updates" mega-cell + manual notes going forward.
model DealNote {
  id        String    @id @default(cuid())
  deal      Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId    String
  noteDate  DateTime? // parsed date; null when the line had no clear date
  body      String    @db.Text
  source    String    @default("manual") // "migration" | "manual" | "change"
  createdAt DateTime  @default(now())

  // Activity and comments (docs/specs/activity-comments.md 2.9, question 1).
  // The note's author; old notes get it from scripts/backfill-deal-note-authors.ts.
  author       User?     @relation("DealNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorUserId String?
  data         Json      @default("{}") // a change entry: { field, from, to }
  editedAt     DateTime?
  deletedAt    DateTime? // soft delete, so Undo can bring it back

  @@index([dealId, noteDate])
}

// ---------------------------------------------------------------------------
// Properties — from the "Property Information" tab (~10 owned properties).
// ---------------------------------------------------------------------------
model Property {
  id      String @id @default(cuid())
  address String

  llcOwner     String? // plain text for now (HG Capital Partners LLC, HG Buffalo Holding 1/2 LLC, ...)
  refiTarget   String? // e.g. "-->HG3" from SREO
  attorney     String?
  lender       String? // Vontive / Conventus / ...
  loanServicer String? // Fay Servicing / FCI / ...

  status          String? // Rehabbing / Refinancing / Refinanced / Stabilized / Hold / Flip / Sold
  strategy        String? // Hold / Flip / BRRRR / Sell / TBD
  purchaseDate    DateTime?
  purchasePrice   Decimal?  @db.Decimal(12, 2)
  closingCosts    Decimal?  @db.Decimal(12, 2)
  refinanceDate   DateTime?
  currentLoan     Decimal?  @db.Decimal(12, 2)
  value           Decimal?  @db.Decimal(12, 2) // appraised / estimated
  replacementCost Decimal?  @db.Decimal(12, 2)
  rehabAmount     Decimal?  @db.Decimal(12, 2)
  rehabMonths     Decimal?  @db.Decimal(8, 2)
  sqft            Int?
  // The building's bedrooms and bathrooms, all units together (Details and the header, Nov 14). Baths take halves: 1.5.
  beds            Int?
  baths           Decimal?  @db.Decimal(6, 2)
  unitCount       Int?

  // Loan — flat, one current loan per property (refi history is a later model).
  loanNumber          String?
  loanType            String? // DSCR 30yr / Bridge / Portfolio / ... (src/lib/config.ts)
  loanOriginalAmount  Decimal?  @db.Decimal(12, 2)
  loanRate            Decimal?  @db.Decimal(6, 3)
  loanPaymentMonthly  Decimal?  @db.Decimal(12, 2)
  loanOriginationDate DateTime?
  loanMaturityDate    DateTime? // balloon / maturity — load-bearing
  loanEscrow          Boolean   @default(false)

  // Insurance — a lapse = lender force-places + technical default.
  insuranceCarrier     String?
  insurancePolicyNo    String?
  insuranceCoverage    Decimal?  @db.Decimal(12, 2)
  insuranceDeductible  Decimal?  @db.Decimal(12, 2)
  insuranceLiability   String? // free text, e.g. "1M / 2M"
  insurancePremium     Decimal?  @db.Decimal(12, 2)
  insuranceRenewalDate DateTime?

  // Other key dates (Buffalo: quarterly taxes — we track the next one).
  propertyTaxDueDate       DateTime?
  rentalRegistrationExpiry DateTime?

  // Per-unit reference data from "Property Information":
  // [{ label, lockboxCode, utilities: { nationalGridAcct, nationalGridAutopay, nationalGridLofl,
  //    nationalFuelAcct, nationalFuelAutopay, nationalFuelLofl, waterAcct, waterAutopay },
  //    equipment: [{ type, model, installYear }] }]
  units Json @default("[]")

  // Building-level major CapEx items, keyed by BUILDING_CAPEX_ITEMS[].key:
  // { roof: { year: "2010", costOverride: 27000 }, windows: { year: "2018" }, ... }
  buildingCapex Json @default("{}")

  notes String? @db.Text

  // The building's front photo (uploads 2.10): a 2560px JPEG with no metadata
  // on public Blob, shown wherever PhotoThumb stands in for the building.
  // photoPathname deletes the blob when it's replaced or removed. Null until set.
  photoUrl      String?
  photoPathname String?

  tasks       Task[]
  attachments PropertyAttachment[]
  sourceDeal  Deal?                @relation("DealToProperty")
  listings    Listing[]

  qboClasses  QboClass[]
  ledgerLines LedgerLine[]

  // Who lives, or lived, in its units (docs/specs/tenants.md).
  leases Lease[]

  // The rehab loans it's part of (docs/specs/rehab-draws.md); one loan can cover several properties.
  rehabs RehabProperty[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Who made the last change (every write in lib/properties/service.ts), so a conflict
  // names them. Null on rows from before it was recorded, and when that user is deleted.
  updatedByUser   User?    @relation("PropertyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?

  // Archived, as on Deal: out of Portfolio and its totals, Home, search, the pickers and the
  // public move-in form. Its tasks keep working and still link to it.
  archivedAt       DateTime?
  archivedByUser   User?     @relation("PropertyArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  archivedByUserId String?

  // Offered on the public move-in form (/residents/moving-in) while on and not archived.
  // New properties start off; Details has the switch.
  showOnMoveInForm Boolean @default(false)

  @@index([address])
}

// ---------------------------------------------------------------------------
// Contacts — merged "Contractor Info" + "Contractor Contact Info" tabs.
// v1: contractors only. Bank/routing numbers are NEVER imported.
// ---------------------------------------------------------------------------
model Contact {
  id             String         @id @default(cuid())
  fullName       String
  company        String?
  // The old free text ("Plumbing / HVAC"), kept as a backup after the move to
  // tradeLinks (docs/specs/contractor-trades.md 3.3). Nothing writes it; a
  // later release drops it.
  trades         String?
  tradeLinks     ContactTrade[]
  tenantFixes    Boolean        @default(false)
  phone          String?
  email          String?
  mailingAddress String?
  billingInfo    String? // e.g. "Check", "Zelle" — no account numbers
  availability   String?
  w9Url          String?
  coiUrl         String?
  comments       String?        @db.Text
  // The portal's sign-in gate and the pickers read it (an inactive contractor still lists and
  // searches, ranked last). Archive is archivedAt below, not this.
  active         Boolean        @default(true)

  // Archived, as on Deal: out of the directory, search and the assignee pickers. Refused while
  // they have open jobs or a portal login (src/lib/archive.ts). The portal doesn't read it.
  archivedAt       DateTime?
  archivedByUser   User?     @relation("ContactArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  archivedByUserId String?

  phoneE164 String? // "+17165551234", for "Text login details"
  asanaGid  String? @unique // Asana user gid, matched once by the import

  qboVendors QboVendor[]

  // A contractor's portal login and what it can see (docs/asana-migration-plan.md §5.1).
  portalAccount       PortalAccount?
  taskAccess          TaskAccess[]
  jobLinks            JobLink[]
  assignedTasks       Task[]               @relation("TaskAssigneeContact")
  completedTasks      Task[]               @relation("TaskCompletedByContact")
  taskEvents          TaskEvent[]
  uploadedAttachments TaskAttachment[]     @relation("AttachmentUploadedByContact")
  checkedItems        TaskChecklistItem[]  @relation("ChecklistDoneByContact")
  taskReadStates      TaskReadState[]
  notifications       NotificationOutbox[]

  // Onboarding (docs/specs/contractor-onboarding.md, section 5). Only people who came in by a personal invite or the
  // shared sign-up link are ever in setup; every row from before it, and anyone staff add, is STAFF and never is.
  signupSource   SignupSource      @default(STAFF)
  // A sign-up from the shared link waits for a partner's Keep (the New badge and Home's Needs you row).
  needsReview    Boolean           @default(false)
  // The furthest setup step saved ("details", "trades", "w9", "insurance"), for "W-9 · 4 of 6".
  setupStep      String?
  // Details, trades and a W-9 are in: the contractor is Active, and Needs you asks for the Baselane link.
  setupDoneAt    DateTime?
  // "Anything we didn't list?" on the trades step.
  tradesNote     String?
  // "I don't carry business insurance".
  noInsurance    Boolean           @default(false)
  // When a partner sent Baselane's bank-details link (Needs you, Sent).
  baselaneSentAt DateTime?
  portalInvites  PortalInvite[]
  documents      ContactDocument[]

  // Contractor invoices (docs/contractor-invoices-plan.md): theirs, the ones they sent, and their lines in an invoice's history.
  invoices        Invoice[]      @relation("InvoiceContact")
  createdInvoices Invoice[]      @relation("InvoiceCreatedByContact")
  invoiceEvents   InvoiceEvent[] @relation("InvoiceEventActorContact")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
}

// What contractors do (docs/specs/contractor-trades.md): each trade once,
// and who does which. Staff add a trade from the picker; the names follow
// src/lib/contractors/trade-map.ts.
// A personal invite, or the one shared sign-up link (docs/specs/contractor-onboarding.md, sections 3 and 6). The
// token goes only into the text or email; this keeps its SHA-256, as for reset links (lib/portal/tokens.ts).
model PortalInvite {
  id              String    @id @default(cuid())
  // The person a personal invite is for. Null on the shared link.
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId       String?
  shared          Boolean   @default(false)
  tokenHash       String    @unique
  // What the partner typed, prefilled on the account step.
  email           String?
  phone           String?
  createdBy       User?     @relation("PortalInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?
  // Set from the browser after the page loads, so a link preview's fetch doesn't count (section 6).
  openedAt        DateTime?
  // A personal invite works once.
  usedAt          DateTime?
  // A personal invite lasts 14 days. Resend, or Reset link for the shared one, sets it to now.
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([contactId])
  @@index([shared])
}

// A contractor's W-9 or insurance file, uploaded during setup (or later, from the account menu). Private Blob; served
// to staff and to the contractor it belongs to.
model ContactDocument {
  id                  String         @id @default(cuid())
  contact             Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId           String
  kind                ContactDocKind
  url                 String
  pathname            String         @unique
  filename            String
  size                Int
  contentType         String?
  // The contractor, from the portal (no relation: a contact's own file).
  uploadedByContactId String?
  uploadedByUser      User?          @relation("ContactDocumentUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedByUserId    String?
  createdAt           DateTime       @default(now())

  @@index([contactId, kind])
}

enum SignupSource {
  STAFF
  INVITE
  LINK
}

enum ContactDocKind {
  W9
  INSURANCE
}

model Trade {
  id        String         @id @default(cuid())
  name      String // "Plumbing", "Pest control"
  key       String         @unique // the name lowercased, single spaces, no commas: tradeKey()
  createdAt DateTime       @default(now())
  contacts  ContactTrade[]
}

model ContactTrade {
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  trade     Trade   @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  tradeId   String

  @@id([contactId, tradeId])
  @@index([tradeId])
}

// ---------------------------------------------------------------------------
// Tasks — from the Asana CSV export (~2,175 rows). Linked to a Property via
// the Asana section name where possible.
// ---------------------------------------------------------------------------
// Seven states (docs/asana-migration-plan.md D6). OPEN is shown as "To do";
// it keeps its old name so existing rows need no rewrite. Sort and filter by
// the explicit lists in src/lib/task-scope.ts, never by enum order: the new
// values were appended after DONE.
enum TaskStatus {
  OPEN
  DONE
  SCHEDULED
  IN_PROGRESS
  WAITING
  REVIEW
  CANCELED
  // Saved by Claude and waiting for a partner to Add it (docs/specs/tasks-from-claude.md
  // section 6). Neither active nor closed: no list, count, email or contractor sees it.
  DRAFT
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(OPEN)

  // Exactly one of these is set, or none (a CHECK in the migration enforces it).
  assignee          User?    @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  assigneeUserId    String?
  assigneeContact   Contact? @relation("TaskAssigneeContact", fields: [assigneeContactId], references: [id])
  assigneeContactId String?
  // Legacy free text from the CSV import. Display fallback only; assignment
  // goes through assigneeContactId now. Dropped once every row is mapped.
  assigneeName      String?
  assigneeEmail     String?

  dueDate          DateTime?
  startDate        DateTime?
  scheduledFor     DateTime? // the booked visit date while SCHEDULED (UTC midnight, like dueDate)
  // When staff marked Permission to enter on an occupied unit (docs/specs/tenants.md section 8);
  // null: Tenant only. Not copied to repeats; a unit or property change clears it.
  entryPermittedAt DateTime?
  waitingOn        String? // the reason while WAITING: "city inspection", "gas co."
  unitLabel        String? // matches a Property.units[].label; picks the lockbox code
  // Set by Discard on a draft from Claude (docs/specs/tasks-from-claude.md 6.3): gone from every list
  // at once, and deleted with its files by the every-minute run about 10 minutes later. Undo clears it.
  discardedAt      DateTime?
  priority         String?

  // Repeats: when done, the next copy is created (src/lib/tasks/repeat.ts).
  // { freq: "days" | "weeks" | "monthly" | "quarterly" | "yearly", interval: n, dayOfMonth?: 1-31, weekday?: 0-6 (weekly, 0 Sunday) }
  repeatRule     Json?
  repeatSeriesId String?

  createdBy            User?    @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId      String?
  completedByUser      User?    @relation("TaskCompletedByUser", fields: [completedByUserId], references: [id], onDelete: SetNull)
  completedByUserId    String?
  completedByContact   Contact? @relation("TaskCompletedByContact", fields: [completedByContactId], references: [id], onDelete: SetNull)
  completedByContactId String?

  taskTemplate   TaskTemplate? @relation(fields: [taskTemplateId], references: [id], onDelete: SetNull)
  taskTemplateId String?

  // Asana sync (scripts/asana/*). appEditedAt is set only by app and portal
  // writes, never by @updatedAt, so the delta sync can tell app edits apart.
  appEditedAt     DateTime?
  asanaLastSynced Json? // the Asana field values as of the last sync, for a three-way merge
  asanaSyncedAt   DateTime?

  bucket     String  @default("Unfiled") // Property | General | Pieter properties | JMPL | Template | Unfiled
  sectionRaw String? // original Asana "Section/Column"
  tags       String?
  links      Json    @default("[]")

  asanaId String? @unique // idempotent re-import
  autoKey String? @unique // "<propertyId>:<slug>" — handle for auto-created key-date reminders

  deal       Deal?     @relation(fields: [dealId], references: [id])
  dealId     String?
  property   Property? @relation(fields: [propertyId], references: [id])
  propertyId String?

  attachments   TaskAttachment[]
  events        TaskEvent[]
  checklist     TaskChecklistItem[]
  access        TaskAccess[]
  jobLinks      JobLink[]
  linkSessions  PortalSession[]      @relation("PortalSessionOnlyTask")
  readStates    TaskReadState[]
  notifications NotificationOutbox[]
  // The invoices tacked onto this job (docs/contractor-invoices-plan.md, M7). Deleting the job keeps them.
  invoiceLinks  InvoiceTask[]
  // Set when a resident sent this from their link (docs/specs/maintenance-requests.md).
  resident      ResidentRequest?
  // Set when New task made this with files picked on the form (docs/specs/new-task-checklist-photos.md).
  newTaskForm   NewTaskForm?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status])
  @@index([bucket])
  @@index([propertyId])
  @@index([dealId])
  @@index([assigneeContactId])
  @@index([repeatSeriesId])
}

// Who can see a comment, file or event: SHARED reaches the assigned
// contractor, INTERNAL is Connor and Pieter only. The database default is
// INTERNAL so anything written without a choice fails closed.
enum Visibility {
  SHARED
  INTERNAL
}

enum AttachmentKind {
  IMAGE
  VIDEO
  FILE
  LINK // a Dropbox/Drive/Box link from Asana; no bytes in Blob
}

// Files on a task. Bytes live in private Vercel Blob; this row keeps the
// metadata. Served only through /api/files/task/<id>, which checks who's asking.
model TaskAttachment {
  id          String         @id @default(cuid())
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  event       TaskEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId     String? // the comment it was posted with, if any
  url         String? // Blob URL; null for LINK
  pathname    String?        @unique // Blob pathname, needed to delete the blob; null for LINK
  linkUrl     String? // LINK only
  filename    String // original file name, shown to the user
  size        Int? // bytes; null for LINK
  contentType String?
  kind        AttachmentKind @default(FILE)
  visibility  Visibility     @default(INTERNAL)

  // At most one uploader (CHECK in the migration); neither for imported files
  // whose Asana uploader couldn't be matched.
  uploadedByUser      User?    @relation("AttachmentUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedByUserId    String?
  uploadedByContact   Contact? @relation("AttachmentUploadedByContact", fields: [uploadedByContactId], references: [id], onDelete: SetNull)
  uploadedByContactId String?
  // A resident's photo or video from their request link (docs/specs/maintenance-requests.md). At most one uploader of the three (CHECK).
  uploadedByTenant    Tenant?  @relation("AttachmentUploadedByTenant", fields: [uploadedByTenantId], references: [id], onDelete: SetNull)
  uploadedByTenantId  String?
  // A staff upload's contractor: whoever was assigned when it was Shared. The
  // portal shows it to that contractor only, never to the next one on the
  // job (src/lib/portal/queries.ts). Null when no contractor was assigned. No
  // foreign key on purpose: if the contact is deleted the file stays theirs
  // instead of turning visible to everyone.
  audienceContactId   String?

  thumbPathname  String? // ~1024px JPEG, for grids
  posterPathname String? // a frame of a video
  width          Int?
  height         Int?
  durationSec    Float?

  asanaGid  String?   @unique
  deletedAt DateTime? // contractors only ever soft-delete
  createdAt DateTime  @default(now())

  @@index([taskId])
  @@index([eventId])
}

enum TaskEventKind {
  COMMENT
  CREATED
  ASSIGNED
  STATUS
  DUE
  SCHEDULED
  PROPERTY
  TITLE
  NOTES
  ATTACHMENT
  CHECKLIST
  ACCESS
  REPEAT_CREATED
  CONFLICT // the Asana delta sync and the app disagreed; see data
  REPEAT // repeats turned on, changed or off (patchTask only)
}

enum EventSource {
  APP // staff, in the app
  PORTAL // a contractor
  SYSTEM // reminders, the move-in form, repeats
  ASANA // imported story
  CLAUDE // a partner, through their Claude connector: the draft's CREATED event
}

// One timeline per task: comments, system changes and imported Asana stories.
// System kinds are always INTERNAL; the portal shows contractors a fixed
// allowlist (src/lib/portal/queries.ts).
model TaskEvent {
  id                String        @id @default(cuid())
  task              Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId            String
  kind              TaskEventKind
  visibility        Visibility    @default(INTERNAL)
  actorUser         User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUserId       String?
  actorContact      Contact?      @relation(fields: [actorContactId], references: [id], onDelete: SetNull)
  actorContactId    String?
  actorLabel        String // kept even if the person is later deleted: "Connor Swofford", "Zack (Outlaw Carpentry)", "Property reminder"
  // On a Shared staff or system event: the contractor assigned when it was
  // written, so a reply to Zack never reaches whoever gets the job next
  // (src/lib/portal/queries.ts). Null when no contractor was assigned, and on
  // contractor and imported rows. No foreign key, as on TaskAttachment.
  audienceContactId String?
  body              String?       @db.Text
  data              Json          @default("{}") // from/to values, imported HTML
  source            EventSource   @default(APP)
  asanaStoryGid     String?       @unique
  editedAt          DateTime?
  // A soft delete. On a COMMENT, its author deleted it (or a contractor took
  // back a photo post, `data.batch`). On any other kind it means an undone
  // approval: only core.ts undoApproval soft-deletes a non-COMMENT event, so
  // "STATUS with deletedAt set" reads as "approval undone". markedDoneAt and
  // lastReview read to=REVIEW lines with no deletedAt filter, which holds only
  // while no Mark done can be undone.
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())

  attachments TaskAttachment[]

  @@index([taskId, createdAt])
}

// Checklist items (Asana subtasks become these). A table, not JSON: a
// contractor and a partner can tick items at the same time.
model TaskChecklistItem {
  id              String    @id @default(cuid())
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId          String
  title           String
  done            Boolean   @default(false)
  doneAt          DateTime?
  doneByUser      User?     @relation("ChecklistDoneByUser", fields: [doneByUserId], references: [id], onDelete: SetNull)
  doneByUserId    String?
  doneByContact   Contact?  @relation("ChecklistDoneByContact", fields: [doneByContactId], references: [id], onDelete: SetNull)
  doneByContactId String?
  assigneeLabel   String? // from an imported Asana subtask; display only
  dueDate         DateTime? // from an imported Asana subtask; display only
  position        Int       @default(0)
  asanaGid        String?   @unique
  // Make task (docs/specs/missing-info.md, D9): the missing-info row this item stands for,
  // "<check>|<subject>". The item ticks itself once that row is filled in or skipped.
  checkKey        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([taskId, position])
  @@index([checkKey])
}

// When each person last opened a task, for "2 new" badges. One row per
// (task, user) or (task, contact); a CHECK keeps exactly one of the two set.
model TaskReadState {
  id         String   @id @default(cuid())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId  String?
  lastSeenAt DateTime @default(now())

  @@unique([taskId, userId])
  @@unique([taskId, contactId])
}

// Playbooks (NEW TENANT, NEW REFI, ...). Items are edited as a whole list;
// order is array order.
// [{ title, notes?, assigneeUserId?, assigneeContactId?, dueOffsetDays? }]
model TaskTemplate {
  id                    String    @id @default(cuid())
  name                  String
  description           String?   @db.Text
  anchorLabel           String? // "Move-in date", "Closing date"; UI falls back to "Start date"
  items                 Json      @default("[]")
  sourceAsanaSectionGid String?   @unique
  archivedAt            DateTime?
  // Photos a contractor's Mark done asks for on this playbook's jobs (uploads
  // 2.8, choice 5 A). Null or 0 means optional, every job's default.
  finishPhotosRequired  Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tasks Task[]

  @@index([archivedAt])
}

// ---------------------------------------------------------------------------
// Contractor portal (docs/asana-migration-plan.md §5.1). Contractors are never
// User rows: every staff gate (requireUser) reads only the staff cookie, so a
// portal session can't open anything staff-only.
// ---------------------------------------------------------------------------

enum AccessSource {
  ASSIGNEE // created by assigning; revoked by reassigning
  MANUAL // shared by hand with an extra person
}

// Which contractor can see which task. canAccessTask() also requires an
// active PortalAccount, an active Contact and a live session.
model TaskAccess {
  id              String       @id @default(cuid())
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId          String
  contact         Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId       String
  source          AccessSource @default(ASSIGNEE)
  grantedBy       User?        @relation(fields: [grantedByUserId], references: [id], onDelete: SetNull)
  grantedByUserId String?
  createdAt       DateTime     @default(now())
  revokedAt       DateTime?

  @@unique([taskId, contactId])
  @@index([contactId])
}

enum PortalAccountStatus {
  ACTIVE
  DISABLED
}

// What Resend's webhook last said about mail to an address (docs/specs/emails-redesign.md, section 5).
enum EmailProblem {
  BOUNCED // the receiving server refused it for good
  SUPPRESSED // Resend didn't send it: the address is on its suppression list after a bounce or a spam report
  COMPLAINED // delivered, then marked as spam
}

model PortalAccount {
  id                 String              @id @default(cuid())
  contact            Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId          String              @unique
  // Lowercased. Never also a User email (checked in src/lib/portal/accounts.ts)
  // so /login knows which kind of account an address belongs to.
  email              String              @unique
  passwordHash       String // scrypt, same format as User.passwordHash (src/lib/password.ts)
  mustChangePassword Boolean             @default(true) // a starting password set by staff
  status             PortalAccountStatus @default(ACTIVE)
  // The "Job emails" switch on the contractor's Portal access card (docs/specs/contractor-email-switch.md).
  // Off stops every task email to them. Emails also wait for the first sign-in (lastSignInAt below);
  // the rule that reads both is src/lib/portal/job-emails.ts.
  jobEmails          Boolean             @default(true)
  // Mail to this login that isn't getting through (src/lib/email/delivery-events.ts): a bounce, a suppression or a
  // spam report, null when none. emailEventAt is when Resend saw the newest event applied (one of those, or a
  // delivery that cleared one), so a late or repeated webhook changes nothing; emailEventTo is the address it was
  // about. A problem counts only while emailEventTo is still `email`, so changing the address clears it. It never
  // touches jobEmails.
  emailProblem       EmailProblem?
  emailEventAt       DateTime?
  emailEventTo       String?
  createdBy          User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId    String?
  lastSignInAt       DateTime?
  lastSeenAt         DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  sessions    PortalSession[]
  resetTokens PasswordResetToken[]
  signInLinks PortalSignInLink[]
}

// Database-backed so "Sign out everywhere" and "Remove access" take effect on
// the next request. The cookie holds a random token; only its hash is stored.
model PortalSession {
  id         String        @id @default(cuid())
  account    PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String
  tokenHash  String        @unique
  createdAt  DateTime      @default(now())
  lastUsedAt DateTime      @default(now())
  expiresAt  DateTime
  userAgent  String?
  revokedAt  DateTime?
  // Set when an email's job link started the session: it opens this one job and nothing else
  // (docs/specs/contractor-job-emails.md, section 3). Null for a session from signing in.
  onlyTask   Task?         @relation("PortalSessionOnlyTask", fields: [onlyTaskId], references: [id], onDelete: Cascade)
  onlyTaskId String?
  jobLink    JobLink?      @relation(fields: [jobLinkId], references: [id], onDelete: SetNull)
  jobLinkId  String?

  @@index([accountId])
}

/// A link in a job email (docs/specs/contractor-job-emails.md, section 3). The token is only in the email; this keeps
/// its SHA-256. A contractor's EMAIL or CREW link opens the job as them; a partner's STAFF link only shows the
/// email's photos. Revoked by Remove access and Sign out everywhere; a link for a job they've lost, or that closed,
/// stops on its own.
model JobLink {
  id         String      @id @default(cuid())
  tokenHash  String      @unique
  kind       JobLinkKind
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  contact    Contact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId  String?
  user       User?       @relation("JobLinkUser", fields: [userId], references: [id], onDelete: Cascade)
  userId     String?
  createdAt  DateTime    @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  sessions PortalSession[]

  @@index([taskId])
  @@index([contactId])
}

enum JobLinkKind {
  EMAIL // a contractor's job email
  CREW // the contractor's "Text to my crew"
  STAFF // a partner's job email: photos only
  REPLY // a job email's reply address: lets a reply post to the job, never opens it
}

/// What a crew member's link, or the job page they have open, says once the job is deleted
/// (docs/specs/emails-redesign.md, Q7). A delete takes the job's links and sessions with it, so deleteTask keeps one
/// row per CREW link and per live crew session, under that token's hash, with only the words the page shows: "This
/// job is canceled. No need to go.", the title and the short street. No foreign keys, since the job is gone. Never
/// read past expiresAt (30 days, or the session's own end if sooner); the next delete that writes notes purges them
/// (src/lib/portal/gone-crew-jobs.ts, the only writer).
model GoneCrewJob {
  tokenHash String          @id
  kind      GoneCrewJobKind
  title     String
  street    String?
  deletedAt DateTime        @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

enum GoneCrewJobKind {
  LINK // a CREW JobLink's tokenHash: /j/<token>
  SESSION // a crew PortalSession's tokenHash: the portal cookie
}

// A "Forgot password" link, for a contractor login or a staff User
// (docs/specs/staff-password-reset.md). Exactly one of accountId and userId
// is set: a CHECK in the migration, since Prisma can't say it.
model PasswordResetToken {
  id        String         @id @default(cuid())
  account   PortalAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([accountId])
  @@index([userId])
}

// "Email me a sign-in link" (docs/specs/contractor-scheduled-date.md section 12): a contractor on an email's job link
// asks for one from the Welcome back page, and it opens My jobs on any phone. Sent only to the login's own email,
// works once, for 15 minutes. The link is only in the email; this keeps its hash.
model PortalSignInLink {
  id        String        @id @default(cuid())
  account   PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([accountId])
}

// One partner's Claude account, allowed to read the directory and save draft
// tasks as that partner (docs/specs/tasks-from-claude.md, sections 7 and 8).
// Made when the partner taps Allow; connectedAt is set when Claude swaps the
// code for tokens. One live row per partner: a new Allow revokes the old one.
// A password change ends it too (the token check compares createdAt with
// User.passwordChangedAt, as src/lib/auth.ts does for sessions).
model ClaudeConnection {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  clientId        String // Claude's client identity as it presented itself
  createdAt       DateTime  @default(now())
  connectedAt     DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  revokedByUserId String? // which partner tapped Disconnect; no FK, it's a note

  tokens OAuthToken[]

  @@index([userId])
}

enum OAuthTokenKind {
  CODE
  ACCESS
  REFRESH
}

// The connector's sign-in tokens. Only the SHA-256 of each is stored, like
// PortalSession and JobLink (src/lib/portal/tokens.ts). A code is single use
// (usedAt); a refresh token is replaced on every use, and one presented again
// after that revokes the whole connection.
model OAuthToken {
  id            String           @id @default(cuid())
  connection    ClaudeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId  String
  kind          OAuthTokenKind
  tokenHash     String           @unique
  expiresAt     DateTime
  usedAt        DateTime?
  // On a CODE: what the token call has to match.
  codeChallenge String?
  redirectUri   String?
  resource      String?
  createdAt     DateTime         @default(now())

  @@index([connectionId])
  @@index([expiresAt])
}

enum SecurityEventKind {
  SIGN_IN_OK
  SIGN_IN_FAILED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  SESSIONS_REVOKED
  ACCOUNT_CREATED
  ACCOUNT_DISABLED
  LOCKBOX_VIEWED
  TENANT_VIEWED
  CLAUDE_CONNECTED
  CLAUDE_DISCONNECTED
  SIGN_IN_LINK_REQUESTED
}

// Audit log for the portal. No foreign keys on purpose: it outlives the rows
// it mentions.
model SecurityEvent {
  id        String            @id @default(cuid())
  kind      SecurityEventKind
  userId    String?
  contactId String?
  taskId    String?
  data      Json              @default("{}")
  ipHash    String?
  createdAt DateTime          @default(now())

  @@index([createdAt])
  @@index([contactId, createdAt])
}

// Emails waiting to go out. Changes to one task for one recipient within a
// short window bundle into one row (and one email): openKey is set while the
// row is unsent and cleared when it's sent, so an upsert on it is atomic.
// Exactly one recipient (CHECK in the migration).
model NotificationOutbox {
  id                 String    @id @default(cuid())
  openKey            String?   @unique // "<u|c>:<recipientId>:<taskId>" while unsent
  recipientUser      User?     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientUserId    String?
  recipientContact   Contact?  @relation(fields: [recipientContactId], references: [id], onDelete: Cascade)
  recipientContactId String?
  task               Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId             String?
  // An invoice's Paid email to its contractor (docs/contractor-invoices-plan.md, 5.3): no task, its own short
  // branch in the drain. Null on every task email and on the partners' invoice bundle ("u:<id>:invoices").
  invoice            Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId          String?
  items              Json      @default("[]") // [{ kind, actorLabel, summary, at }]
  firstAt            DateTime  @default(now())
  sendAfter          DateTime
  sentAt             DateTime?
  attempts           Int       @default(0)
  lastError          String?
  createdAt          DateTime  @default(now())

  @@index([sentAt, sendAfter])
  @@index([invoiceId])
}

// Documents uploaded to a property — same Vercel Blob pattern as TaskAttachment.
// PRIVATE: mortgage statements, insurance docs, etc. Never queried by the
// public site — see Listing.photoUrl below for the public-facing equivalent.
model PropertyAttachment {
  id               String   @id @default(cuid())
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId       String
  url              String
  pathname         String
  filename         String
  size             Int
  contentType      String?
  createdAt        DateTime @default(now())
  // Who added it ("Connor · Oct 3", uploads 2.4). Null on rows from before it
  // was recorded, which show the date alone, and when that user is deleted.
  uploadedByUser   User?    @relation("PropertyAttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedByUserId String?

  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// Rentals — one row per marketable unit. Zillow stays the leasing system of
// record (PRD decision: don't duplicate the full listing there); this is just
// enough to render a card on the public /rentals page and link out to it.
// ---------------------------------------------------------------------------
enum ListingStatus {
  AVAILABLE
  COMING_SOON // on Rentals with a "Coming soon" pill and Notify me
  LEASED // on Rentals last, with a Leased pill
  HIDDEN // saved but not shown publicly (e.g. still being prepped)
}

model Listing {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  unitLabel String // free text — matches a Property.units[].label where possible, not FK'd
  zillowUrl String?

  rent  Decimal? @db.Decimal(10, 2)
  beds  String? // matches Deal.beds/baths — "2", "1.5", "Studio", etc.
  baths String?
  sqft  Int?

  availableDate DateTime?
  status        ListingStatus @default(HIDDEN)

  photos   ListingPhoto[]
  waitlist ListingWaitlistEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([status])
}

// Someone who signed up to hear about a listing (docs/specs/coming-soon.md).
// One row per email per listing; a second sign-up updates the first.
model ListingWaitlistEntry {
  id        String   @id @default(cuid())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  firstName String
  email     String // normalizeEmail: trimmed and lowercased
  phone     String? // readPhone's display form, "716-555-1234"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, email])
}

// A listing's photo gallery — deliberately its own table, not
// PropertyAttachment: a public listing photo and a private mortgage
// statement must never share a table. sortOrder controls both the admin
// editor's left/right reorder and the public carousel's slide order; on
// save the whole set is replaced (full-replace, same convention as
// Property.units/buildingCapex), so a removed photo simply doesn't come back.
model ListingPhoto {
  id        String  @id @default(cuid())
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  url       String
  pathname  String
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([listingId])
}

// ---------------------------------------------------------------------------
// Recently viewed records, for Recent in the command palette (docs/specs/
// search.md 2.5 and 2.10). Kept on the server so a laptop and a phone share
// one list. One row per (user, kind, record): opening it again bumps
// viewedAt. src/lib/recent-views.ts is the only writer and keeps the newest
// 20 per user and kind. recordId has no foreign key (it points at a
// Property, Deal, Task or Contact by kind), so readers skip records deleted
// since. Apart from TaskReadState, which means unread, not recent.
// ---------------------------------------------------------------------------
enum RecentKind {
  PROPERTY
  DEAL
  TASK
  CONTACT // a contractor
}

model RecentView {
  id       String     @id @default(cuid())
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  kind     RecentKind
  recordId String
  viewedAt DateTime   @default(now())

  @@unique([userId, kind, recordId])
  @@index([userId, viewedAt])
}

// ---------------------------------------------------------------------------
// App configuration — a single row (id is always "singleton").
// Today: only the CapEx planning rules (age bands + replacement costs) edited
// at /settings. Built-in defaults live in src/lib/property-types.ts
// (DEFAULT_CAPEX_RULES); absence of this row == defaults.
// ---------------------------------------------------------------------------
model AppConfig {
  id               String   @id @default("singleton")
  capexRules       Json     @default("{}")
  moveInFormSchema Json     @default("{}")
  updatedAt        DateTime @updatedAt
  updatedBy        String? // user.name ?? user.email of the last editor
}

// ===========================================================================
// QuickBooks Online — read-only P&L mirror.
//
// Structure of HG's real company file (verified from exports):
//   - ONE company file, 5 entities (HGC, HG1, HG2, HG MGMT, BMK).
//   - Classes ON, hierarchical: parent = entity, child = "{ENTITY} {property}".
//   - Many classes -> one Property (properties move between LLCs on refi; the
//     management company carries operational lines). Classes partition the
//     ledger, so summing a property's classes never double-counts.
//   - Books start Jan 2026 (~a few hundred P&L lines).
//
// Sync = full-realm wipe-and-reinsert of LedgerLine from the ProfitAndLossDetail
// report (both bases), every run. Reclasses / voids / deletes self-heal.
// ===========================================================================

enum QboConnectionStatus {
  ACTIVE
  EXPIRED // token refresh failed / invalid_grant — UI shows "Reconnect"
  REVOKED // disconnected here or in Intuit
}

enum QboBasis {
  CASH
  ACCRUAL
}

enum QboClassRole {
  UNMAPPED // needs a human decision — pinned to the top of the settings table
  PROPERTY // resolves to exactly one Property
  ENTITY // a bare entity parent class ("HGC", "HG MGMT") — entity overhead
  OVERHEAD // an entity "* General" bucket — entity-level, not a property
  IGNORE // deliberately excluded from every rollup
}

// Fine-grained P&L line bucket — drives the expense-by-category bars + settings.
enum QboCategory {
  RENT
  OTHER_INCOME
  TAXES
  INSURANCE
  REPAIRS
  UTILITIES
  MANAGEMENT
  LEGAL_PROFESSIONAL
  LEASING_COMMISSION
  BANK_FEES
  SOFTWARE
  TRAVEL
  OTHER_OPEX
  DEBT_INTEREST
  UNCATEGORIZED
  CAPEX // balance-sheet; only appears if a GeneralLedger pull is added later
  INTERCOMPANY
  OWNER_EQUITY
  SUSPENSE // escrow / clearing parked in P&L (the $47,934 wire) — excluded from income
  EXCLUDED
  OTHER
}

// Coarse bucket that drives the NOI / cash-flow math.
enum QboTreatment {
  OPERATING_INCOME
  OPERATING_EXPENSE
  NON_OPERATING // bank interest income, owner-funded "rent"
  DEBT_INTEREST
  EXCLUDED // suspense, capex, principal, equity, intercompany, transfers
}

// Per-line signals the account category can't carry (owner P2P and Section-8
// both post to "Rents").
enum QboLineTag {
  OWNER_FUNDED // SCHWAB P2P from the owner, mis-booked to Rents
  SUBSIDY // Section-8 / HAP / HCV voucher rent (real tenant rent)
  INTERNAL_TRANSFER
  NEGATIVE_RECLASS // expense line < 0 — a real correction, kept and netted
  CAPEX_FLAG
}

enum QboSyncTrigger {
  INITIAL
  CRON
  MANUAL
}

enum QboSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL // reconciliation delta over tolerance, or the run bailed on its wall-budget
  FAILED
}

// One row. Child tables relate by realmId (@unique) so a reconnect of the same
// company upserts this row and mappings survive.
model QuickbooksConnection {
  id          String              @id @default(cuid())
  realmId     String              @unique
  environment String              @default("production") // "sandbox" | "production"
  status      QboConnectionStatus @default(ACTIVE)
  companyName String?

  // AES-256-GCM ciphertext (src/lib/quickbooks/crypto.ts). Never logged, never sent to the client.
  accessTokenEnc        String    @db.Text
  refreshTokenEnc       String    @db.Text
  prevRefreshTokenEnc   String?   @db.Text // one-shot fallback for the rotation half-write race
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  tokenRefreshedAt      DateTime?

  accountingMethod QboBasis @default(CASH) // the basis shown by default in the UI
  historyStart     String   @db.VarChar(7) // earliest usable month, "2026-01"

  connectedBy       User   @relation(fields: [connectedByUserId], references: [id])
  connectedByUserId String

  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  lastReconciledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities    QboEntity[]
  classes     QboClass[]
  accounts    QboAccount[]
  vendors     QboVendor[]
  ledgerLines LedgerLine[]
  syncRuns    QboSyncRun[]
}

// The 5 LLCs. Seeded from a static table, not discovered — the class hierarchy
// always carries the entity as the parent class.
model QboEntity {
  id         String               @id @default(cuid())
  realmId    String
  connection QuickbooksConnection @relation(fields: [realmId], references: [realmId], onDelete: Cascade)

  code           String // "HGC" | "HG1" | "HG2" | "HG MGMT" | "BMK"
  name           String // "HG Capital Partners LLC"
  llcOwnerNames  String[] @default([]) // Property.llcOwner strings that resolve here
  isJointVenture Boolean  @default(false) // BMK — 50/50 with partner "BK"
  sortOrder      Int      @default(0)

  classes     QboClass[]
  ledgerLines LedgerLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([realmId, code])
  @@index([realmId])
}

model QboClass {
  id         String               @id @default(cuid())
  realmId    String
  connection QuickbooksConnection @relation(fields: [realmId], references: [realmId], onDelete: Cascade)

  qboId              String
  name               String // leaf name, "HGC 15 Oxford"
  fullyQualifiedName String // "HGC:HGC 15 Oxford"
  parentQboId        String?
  isSubClass         Boolean @default(false)
  active             Boolean @default(true)

  role       QboClassRole @default(UNMAPPED)
  property   Property?    @relation(fields: [propertyId], references: [id])
  propertyId String? // many classes -> one property
  entity     QboEntity?   @relation(fields: [entityId], references: [id])
  entityId   String? // parent entity — set even for PROPERTY / UNMAPPED

  autoMatched   Boolean @default(false) // set by the matcher; any human edit clears it
  autoMatchNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([realmId, qboId])
  @@index([realmId, role])
  @@index([propertyId])
  @@index([entityId])
}

model QboAccount {
  id         String               @id @default(cuid())
  realmId    String
  connection QuickbooksConnection @relation(fields: [realmId], references: [realmId], onDelete: Cascade)

  qboId              String
  name               String
  fullyQualifiedName String
  acctType           String // Intuit AccountType: "Income" | "Expense" | "Other Income" | ...
  acctSubType        String?
  classification     String // "Revenue" | "Expense" | "Asset" | "Liability" | "Equity"
  active             Boolean @default(true)
  parentQboId        String?

  category       QboCategory  @default(OTHER)
  treatment      QboTreatment @default(EXCLUDED) // derived from category (+ interest-income override)
  categoryLocked Boolean      @default(false) // true once a human sets it, or the seed pins it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([realmId, qboId])
  @@index([realmId, category])
}

model QboVendor {
  id         String               @id @default(cuid())
  realmId    String
  connection QuickbooksConnection @relation(fields: [realmId], references: [realmId], onDelete: Cascade)

  qboId       String
  displayName String
  active      Boolean  @default(true)
  contact     Contact? @relation(fields: [contactId], references: [id])
  contactId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([realmId, qboId])
  @@index([contactId])
}

// One row per QuickBooks transaction line, per accounting basis. Rebuilt in full
// on every sync. Every resolved dimension is denormalized here so /financials
// views are plain groupBy — a re-map is an updateMany over these rows.
model LedgerLine {
  id         String               @id @default(cuid())
  realmId    String
  connection QuickbooksConnection @relation(fields: [realmId], references: [realmId], onDelete: Cascade)

  basis       QboBasis
  periodMonth String   @db.VarChar(7) // "2026-03"
  txnDate     DateTime @db.Date

  qboTxnId  String
  txnType   String // "Deposit" | "Expense" | "Journal Entry" | "Bill" | ...
  lineKey   String // "${qboTxnId}:${accountQboId}:${classKey}:${signedCents}:${ordinal}"
  docNumber String?

  name         String? // QBO "Name" (payee/customer), verbatim
  memo         String?
  businessName String? // QBO "Business"/Department column, verbatim (mismatch diagnostics)

  accountQboId   String
  accountName    String
  splitAccount   String? // "Item split account" — the contra side
  classification String
  category       QboCategory
  treatment      QboTreatment

  classKey  String // QboClass.qboId, or "__UNCLASSED__"
  className String?

  property   Property?    @relation(fields: [propertyId], references: [id])
  propertyId String?
  entity     QboEntity?   @relation(fields: [entityId], references: [id])
  entityId   String?
  classRole  QboClassRole @default(UNMAPPED)

  lineTags     QboLineTag[]
  vendorQboId  String?
  customerName String?

  amount Decimal @db.Decimal(14, 2) // signed, natural (income +, expense +, contra/reclass -)
  raw    Json

  syncRunId String?
  createdAt DateTime @default(now())

  @@unique([realmId, basis, lineKey])
  @@index([realmId, basis, periodMonth])
  @@index([propertyId, basis, periodMonth])
  @@index([entityId, basis, periodMonth])
  @@index([realmId, basis, treatment, periodMonth])
  @@index([realmId, basis, category, periodMonth])
  @@index([qboTxnId])
}

model QboSyncRun {
  id         String               @id @default(cuid())
  realmId    String
  connection QuickbooksConnection @relation(fields: [realmId], references: [realmId], onDelete: Cascade)

  trigger QboSyncTrigger
  status  QboSyncStatus  @default(RUNNING)

  startedAt   DateTime  @default(now())
  heartbeatAt DateTime  @default(now()) // row-based lock (pgbouncer kills advisory locks)
  finishedAt  DateTime?

  monthsProcessed Int     @default(0)
  stats           Json    @default("{}") // { reconciliation, dataQuality, counts, warnings }
  error           String? @db.Text

  @@index([realmId, startedAt])
  @@index([status, heartbeatAt])
}

// ---------------------------------------------------------------------------
// Tenants and leases (docs/specs/tenants.md). Staff-only: the portal reads a
// job's tenants through src/lib/portal/access-code.ts alone. Every write goes
// through src/lib/tenants/service.ts.
// ---------------------------------------------------------------------------

// A person who lives, or lived, in one of HG Capital's units.
model Tenant {
  id        String        @id @default(cuid())
  fullName  String
  phone     String? // as shown: "716-555-1234 ext 2"
  phoneE164 String? // what Call and Text dial, from readPhone
  email     String?
  notes     String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  leases    LeaseTenant[]

  // Maintenance requests (docs/specs/maintenance-requests.md).
  links    ResidentLink[]
  requests ResidentRequest[]
  uploads  TaskAttachment[]  @relation("AttachmentUploadedByTenant")

  @@index([fullName])
}

enum LeaseSource {
  APP
  IMPORT
  PLAYBOOK
}

// One household's stay in one unit, from moving in to moving out. Its terms
// are the leases they signed; renewing adds a term, not a lease.
model Lease {
  id              String        @id @default(cuid())
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  propertyId      String
  // The unit's id in Property.units; null on a property with no units. unitLabel
  // follows renames through writeUnits, past leases included, and keeps its last
  // label once the unit is deleted.
  unitId          String?
  unitLabel       String?
  movesIn         DateTime? // UTC midnight of a Buffalo day; null: they live there now
  movesOut        DateTime? // the day they leave; null until they give notice
  deposit         Decimal?      @db.Decimal(12, 2)
  notes           String?       @db.Text
  source          LeaseSource   @default(APP)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdByUser   User?         @relation("LeaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?
  tenants         LeaseTenant[]
  terms           LeaseTerm[]
  files           LeaseFile[]

  // Maintenance requests (docs/specs/maintenance-requests.md).
  residentLinks ResidentLink[]
  requests      ResidentRequest[]

  @@index([propertyId, unitId])
}

model LeaseTenant {
  lease    Lease   @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  leaseId  String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantId String
  // Exactly one per lease, held by the service and a partial unique index in the migration.
  primary  Boolean @default(false)
  position Int // the order staff entered them; the primary shows first

  @@id([leaseId, tenantId])
  @@index([tenantId])
}

// A signed lease: its dates and its rent.
model LeaseTerm {
  id             String     @id @default(cuid())
  lease          Lease      @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  leaseId        String
  startsOn       DateTime // UTC midnight of a Buffalo day
  endsOn         DateTime? // null: month to month
  rent           Decimal    @db.Decimal(12, 2) // the whole monthly rent
  subsidy        Decimal?   @db.Decimal(12, 2) // the housing authority's share (Section 8)
  subsidyFrom    String? // "Buffalo Municipal Housing Authority"
  subsidyContact String? // the housing authority contact (the Section 8 caseworker) for this term
  subsidyEmail   String? // that contact's email
  file           LeaseFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  fileId         String?    @unique

  @@index([leaseId, startsOn])
}

// A signed lease's PDF, stored like PropertyAttachment (private Blob).
model LeaseFile {
  id               String     @id @default(cuid())
  lease            Lease      @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  leaseId          String
  url              String
  pathname         String
  filename         String
  size             Int
  contentType      String?
  createdAt        DateTime   @default(now())
  uploadedByUser   User?      @relation("LeaseFileUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedByUserId String?
  term             LeaseTerm?

  @@index([leaseId])
}

// ---------------------------------------------------------------------------
// Missing info (docs/specs/missing-info.md). The gaps themselves are never
// stored: src/lib/missing/checks.ts computes them from the records on each
// read. This keeps only a partner's "Doesn't apply" (D3), one row per check
// on one record. Every write goes through src/lib/missing/service.ts.
// ---------------------------------------------------------------------------
model MissingInfoSkip {
  id              String   @id @default(cuid())
  // The check: "insurance.carrier", "utility.fuelLofl", "lease.pdf", ...
  check           String
  // The record: "property:<id>", "unit:<propertyId>:<unitId>", "lease:<id>", "contact:<id>".
  subject         String
  createdBy       User?    @relation("MissingInfoSkipBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@unique([check, subject])
  @@index([subject])
}

// ---------------------------------------------------------------------------
// Rehab draws (docs/specs/rehab-draws.md). A rehab is one loan's rehab
// holdback: its budget line by line and the draws on it. It follows the loan,
// so one rehab can cover more than one property (RehabProperty). Every write
// goes through src/lib/draws/service.ts; the figures (funded, at the lender,
// draft, left) are computed in src/lib/draws/figures.ts, never stored.
// ---------------------------------------------------------------------------
enum RehabSource {
  APP // set up by hand
  WORKSHEET // read from the lender's Renovation Draw Worksheet
}

// A draw's stages, in order (R4).
enum DrawStage {
  DRAFT
  SENT
  INSPECTION
  APPROVED
  FUNDED
}

model Rehab {
  id              String          @id @default(cuid())
  // "765 and 767 Prospect": the properties' streets when it's set up, editable.
  name            String
  lender          String?
  // The lender's rehab holdback. Null: the lines' original total stands in.
  holdback        Decimal?        @db.Decimal(12, 2)
  notes           String?         @db.Text
  source          RehabSource     @default(APP)
  // Marked done after the last draw or the refi; it leaves the property page and Draws' open list.
  doneAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdByUser   User?           @relation("RehabCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?
  properties      RehabProperty[]
  lines           RehabLine[]
  draws           Draw[]

  @@index([doneAt])
}

model RehabProperty {
  rehab      Rehab    @relation(fields: [rehabId], references: [id], onDelete: Cascade)
  rehabId    String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  @@id([rehabId, propertyId])
  @@index([propertyId])
}

// One budget line: the lender's Original Budget and Change Order columns. Revised is their sum.
model RehabLine {
  id          String     @id @default(cuid())
  rehab       Rehab      @relation(fields: [rehabId], references: [id], onDelete: Cascade)
  rehabId     String
  position    Int
  // The property unit the line is for (R8): its lasting id in Property.units, picked from the rehab's
  // properties. Null on a plain list, or for a worksheet's own unit that wasn't matched to one.
  unitId      String?
  // The unit's label when it was set: the worksheet's "Unit 1", or the picked unit's label. Reads show
  // the property unit's current label when unitId still finds it.
  unitLabel   String?
  name        String
  original    Decimal    @db.Decimal(12, 2)
  changeOrder Decimal    @default(0) @db.Decimal(12, 2)
  amounts     DrawLine[]

  @@index([rehabId, position])
}

model Draw {
  id             String     @id @default(cuid())
  rehab          Rehab      @relation(fields: [rehabId], references: [id], onDelete: Cascade)
  rehabId        String
  number         Int
  stage          DrawStage  @default(DRAFT)
  // When it last moved, for "6 days" and Needs you's no change in 10 days.
  stageChangedAt DateTime   @default(now())
  // Calendar days (UTC midnight of a Buffalo day), and what each stage recorded.
  sentOn         DateTime?
  sentAmount     Decimal?   @db.Decimal(12, 2) // the draft's total when it was sent
  approvedOn     DateTime?
  approvedAmount Decimal?   @db.Decimal(12, 2)
  fundedOn       DateTime?
  fundedAmount   Decimal?   @db.Decimal(12, 2) // what landed, after the lender's fee
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lines          DrawLine[]

  @@unique([rehabId, number])
}

// A draw's amount on one budget line. A line with amounts on a sent draw can't be deleted (Restrict).
model DrawLine {
  draw   Draw      @relation(fields: [drawId], references: [id], onDelete: Cascade)
  drawId String
  line   RehabLine @relation(fields: [lineId], references: [id], onDelete: Restrict)
  lineId String
  amount Decimal   @db.Decimal(12, 2)

  @@id([drawId, lineId])
  @@index([lineId])
}

// ---------------------------------------------------------------------------
// Contractor invoices (docs/contractor-invoices-plan.md, 5.1). A contractor
// sends one from a job, replies to a Done job's email with it, or forwards it
// to invoices@; a partner enters one by hand. It waits in To review, moves to
// To pay on Approve and to Paid on Mark paid. Money never moves in the app.
// Every write goes through src/lib/invoices/service.ts (the rules are in
// core.ts), each with its InvoiceEvent in the same transaction.
// ---------------------------------------------------------------------------
enum InvoiceSource {
  PORTAL // the contractor's Send invoice, signed in
  REPLY // a reply to a Done job's email, with the bill attached
  EMAIL // forwarded to invoices@, by a contractor or a partner
  STAFF // a partner's New invoice, or Use as invoice on a job file
}

// The stages, in order (M4). Contractors read REVIEW as Received and TO_PAY as Approved.
enum InvoiceStage {
  REVIEW
  TO_PAY
  PAID
  NOT_INVOICE // junk, a work photo or a duplicate, cleared by staff: a soft delete (deletedAt)
}

// How it was paid (M9). CARD stays apart because card payments go on a 1099-K, not a 1099-NEC.
enum InvoicePayMethod {
  BASELANE
  CHECK
  ZELLE
  VENMO
  CASH
  CARD
  OTHER
}

enum InvoiceEventKind {
  ARRIVED // made, by any way in
  EDITED // a field or a job link, in To review
  FILE_ADDED
  APPROVED
  REOPENED // Back to review
  PAID
  UNDONE // Undo paid
  NOT_INVOICE
  RESTORED // the Undo of Not an invoice
}

// What became of a received email. Generic, so the planned deals@ and draws@ inboxes can use it too.
enum InboundEmailStatus {
  RECEIVED // stored, not yet filed
  FILED // it made its record (an invoice)
  IGNORED // an automatic reply, or nothing to file
  OVER_CAP // past the day's limits, so dropped and counted (4.3)
}

model Invoice {
  id                      String            @id @default(cuid())
  // Null until someone knows who sent it ("Who's this from?", M11). A deleted contact leaves the invoice.
  contact                 Contact?          @relation("InvoiceContact", fields: [contactId], references: [id], onDelete: SetNull)
  contactId               String?
  source                  InvoiceSource
  stage                   InvoiceStage      @default(REVIEW)
  // As typed, without a leading "#" ("1043", "INV-0042"). Optional.
  invoiceNumber           String?
  // For the duplicate check (M10): letters and digits only, lowercased, leading zeros dropped ("inv0042").
  invoiceNumberNormalized String?
  // The date on the invoice: UTC midnight of a Buffalo day, the day it arrived unless someone changes it.
  invoiceDate             DateTime
  // Always above zero (a CHECK); null until someone types it.
  total                   Decimal?          @db.Decimal(12, 2)
  // A note only staff see.
  note                    String?           @db.Text
  approvedAt              DateTime?
  approvedBy              User?             @relation("InvoiceApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId        String?
  // The paid date a partner picked (UTC midnight of a Buffalo day), and the instant they marked it: the Paid email
  // and the portal wait out the Undo window from paidAt. Set exactly while PAID (a CHECK).
  paidOn                  DateTime?
  paidAt                  DateTime?
  payMethod               InvoicePayMethod?
  // A check number or a short note.
  paidNote                String?
  paidBy                  User?             @relation("InvoicePaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  paidByUserId            String?
  // Who made it: at most one (a CHECK). Neither on an emailed invoice or a system write, where the email's From or
  // the ARRIVED event's actor label says who.
  createdByUser           User?             @relation("InvoiceCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId         String?
  createdByContact        Contact?          @relation("InvoiceCreatedByContact", fields: [createdByContactId], references: [id], onDelete: SetNull)
  createdByContactId      String?
  // The email it came in, for "From the email Zack sent Nov 18" and its words. Unique: one email makes one invoice.
  inboundEmail            InboundEmail?     @relation(fields: [inboundEmailId], references: [id], onDelete: SetNull)
  inboundEmailId          String?           @unique
  // "Possible duplicate" (M10): an older invoice, Paid and Not an invoice ones included, with the same contractor
  // and number or the very same file. Kept by core.ts whenever a contractor, number or file changes. Warns only.
  duplicateOf             Invoice?          @relation("InvoiceDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicateOfId           String?
  duplicates              Invoice[]         @relation("InvoiceDuplicate")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  // Set exactly while NOT_INVOICE (a CHECK): staff cleared it, and Undo brings it back.
  deletedAt               DateTime?

  tasks         InvoiceTask[]
  files         InvoiceFile[]
  events        InvoiceEvent[]
  notifications NotificationOutbox[]

  @@index([stage, invoiceDate])
  @@index([stage, paidOn])
  @@index([contactId, invoiceNumberNormalized])
  @@index([createdAt])
  @@index([duplicateOfId])
}

// A job an invoice is for (M7): any job but a canceled one, whoever it sits on. A job can have several invoices.
model InvoiceTask {
  id        String   @id @default(cuid())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  // Null once the job is deleted: the link then reads as its kept title, with nowhere to go.
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId    String?
  // The job's title when it was linked.
  title     String
  createdAt DateTime @default(now())

  @@unique([invoiceId, taskId])
  @@index([taskId])
}

// An invoice's file: always the invoice's own private Blob copy, so removing a job's file or deleting the job
// never touches it. Served only through /api/files/invoice/<id>.
model InvoiceFile {
  id            String   @id @default(cuid())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId     String
  url           String
  pathname      String   @unique
  filename      String
  size          Int
  contentType   String?
  // Of the bytes, lowercase hex, for "the exact same file" (M10).
  sha256        String
  thumbPathname String? // ~1024px JPEG of an image, for the file card
  width         Int?
  height        Int?
  createdAt     DateTime @default(now())

  @@index([invoiceId])
  @@index([sha256])
}

// An invoice's history. The actor ids are nullable (an email, the system, a deleted person); the label always says who.
model InvoiceEvent {
  id             String           @id @default(cuid())
  invoice        Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  kind           InvoiceEventKind
  actorUser      User?            @relation("InvoiceEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUserId    String?
  actorContact   Contact?         @relation("InvoiceEventActorContact", fields: [actorContactId], references: [id], onDelete: SetNull)
  actorContactId String?
  // "Connor Swofford", "Zack (Outlaw Carpentry)", "zack@gmail.com". Kept if the person is deleted.
  actorLabel     String
  // What changed: { source, files } on ARRIVED; { field, from, to } on EDITED, or { field: "jobs", taskId, added | removed }
  // for a job; { fileId, filename } on FILE_ADDED; { paidOn, method, note } on PAID; { paidOn, method } on UNDONE;
  // { from } on NOT_INVOICE; { to } on RESTORED.
  data           Json             @default("{}")
  createdAt      DateTime         @default(now())

  @@index([invoiceId, createdAt])
}

// A received email, stored as it came in (docs/contractor-invoices-plan.md, 4.3). Generic: other inboxes on the
// same webhook can use it later.
model InboundEmail {
  id         String             @id @default(cuid())
  // Resend's email id, once per email: a webhook Resend retries finds its row.
  resendId   String             @unique
  // The part of the address it was sent to before the @: "invoices".
  localPart  String
  // The sender's address, lowercased (src/lib/email/inbound.ts fromAddress).
  from       String
  // The From header as it came in, which M11 and M12 check for a single address (inbound.ts singleAddress) along
  // with the DMARC result. Null only on a row stored without it, which then never counts as a partner's forward.
  fromLine   String?
  subject    String?
  receivedAt DateTime
  // The whole text body, links kept.
  text       String?            @db.Text
  // Resend's DMARC check of the From: "pass", "fail", "gray", ... Null when Resend didn't say.
  dmarc      String?
  status     InboundEmailStatus @default(RECEIVED)
  createdAt  DateTime           @default(now())
  invoice    Invoice?

  @@index([localPart, receivedAt])
  @@index([from, receivedAt])
}

// A tenant's own link for reporting repairs (docs/specs/maintenance-requests.md):
// /r/<token>, the token stored only as its hash, as job links are. It works
// while the lease is current; Turn off link or a new link revokes it.
model ResidentLink {
  id         String           @id @default(cuid())
  tokenHash  String           @unique
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  lease      Lease            @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  leaseId    String
  emailedAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime         @default(now())
  uploads    ResidentUpload[]

  @@index([tenantId])
  @@index([leaseId])
}

// What a resident sent, beside the task it became: their own words for their
// page (the task's title and notes are staff's to edit), the answers the task
// has no field for, and the step their last email told them.
model ResidentRequest {
  id                   String    @id @default(cuid())
  task                 Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId               String    @unique
  lease                Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  leaseId              String
  tenant               Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantId             String?
  tenantName           String // kept for labels if the tenant row goes
  whatsWrong           String
  details              String?   @db.Text
  letUsIn              Boolean
  pets                 Boolean?
  petsNote             String?
  closedNote           String?
  canceledByResidentAt DateTime?
  // The step and day the resident was last emailed about ("received" until the first change).
  notifiedStep         String    @default("received")
  notifiedDay          DateTime?
  createdAt            DateTime  @default(now())

  @@index([leaseId])
  @@index([notifiedStep])
}

// A photo or video a resident uploaded from their link, checked with head()
// and waiting to be attached to the request it goes with. usedAt is set when
// it is.
// New task's files (docs/specs/new-task-checklist-photos.md): uploaded the moment they're picked, under the person and
// the form's id (made by the browser, one per new task), and held here until Create attaches them to the task. A file
// that finishes after Create attaches as it lands, through the form's NewTaskForm. `attachmentId` is the task file
// it became; one never attached is deleted, blobs and all, once its draft has expired (sweepNewTaskUploads).
model NewTaskUpload {
  id             String         @id @default(cuid())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  formId         String
  pathname       String         @unique
  url            String
  filename       String
  size           Int
  contentType    String
  kind           AttachmentKind
  thumbPathname  String?
  posterPathname String?
  width          Int?
  height         Int?
  durationSec    Float?
  attachmentId   String?
  createdAt      DateTime       @default(now())

  @@index([formId])
  @@index([userId, formId])
  @@index([createdAt])
}

// The task a New task form made, and its "created" line, which the form's files hang from (so the task page, its zip,
// the contractor and the job email all see them as posted). Written by Create when the form had files.
model NewTaskForm {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String   @unique
  eventId   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ResidentUpload {
  id             String         @id @default(cuid())
  link           ResidentLink   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  linkId         String
  pathname       String         @unique
  url            String
  filename       String
  size           Int
  contentType    String
  kind           AttachmentKind
  thumbPathname  String?
  posterPathname String?
  width          Int?
  height         Int?
  durationSec    Float?
  usedAt         DateTime?
  createdAt      DateTime       @default(now())

  @@index([linkId])
}
