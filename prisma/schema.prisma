// HG Capital OS schema.
// Core: Deals, Properties, Contractors, Tasks (v1 migration).
// Financials: a read-only mirror of the QuickBooks Online P&L (QuickbooksConnection …
// LedgerLine). QuickBooks stays the system of record — see /Users/connorswofford/.claude/plans.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the rhel target is the Vercel (AWS Lambda) runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users — 2 trusted internal users (Connor, Pieter). No roles in v1.
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  // scrypt hash, "<saltHex>.<hashHex>" — see src/lib/password.ts. Null means
  // this user can't sign in yet (no roles/self-signup in v1: rows without a
  // hash are provisioned by hand, then backfilled — see
  // scripts/backfill-password-hashes.ts).
  passwordHash String?
  createdAt    DateTime @default(now())

  asanaGid String? @unique // Asana user gid, matched once by the import

  assignedTasks  Task[] @relation("TaskAssignee")
  createdTasks   Task[] @relation("TaskCreatedBy")
  completedTasks Task[] @relation("TaskCompletedByUser")

  taskEvents            TaskEvent[]
  uploadedAttachments   TaskAttachment[]     @relation("AttachmentUploadedByUser")
  checkedItems          TaskChecklistItem[]  @relation("ChecklistDoneByUser")
  taskReadStates        TaskReadState[]
  grantedTaskAccess     TaskAccess[]
  createdPortalAccounts PortalAccount[]
  notifications         NotificationOutbox[]

  qboConnections QuickbooksConnection[]
}

// ---------------------------------------------------------------------------
// Deals — from the "Prospective Deals" tab (~748 rows).
// ---------------------------------------------------------------------------
model Deal {
  id      String @id @default(cuid())
  address String

  // Prices: parsed numbers where possible, raw text always preserved.
  theirPrice    Decimal? @db.Decimal(12, 2)
  theirPriceRaw String?
  ourPrice      Decimal? @db.Decimal(12, 2) // HG target / max offer
  ourPriceRaw   String?
  currentOffer  Decimal? @db.Decimal(12, 2)

  units Int?
  beds  String?
  baths String?
  sqft  Int?
  taxes Decimal? @db.Decimal(12, 2)

  status     String  @default("Active") // configurable list in src/lib/config.ts
  priority   String? // "1 - High", etc.
  vip        Boolean @default(false)
  passReason String?

  sourceUrl String?
  links     Json    @default("[]") // [{ label, url }]

  nextAction    String?
  nextActionDue DateTime?

  rawLatestUpdates String? @db.Text // verbatim from the spreadsheet cell

  convertedProperty   Property? @relation("DealToProperty", fields: [convertedPropertyId], references: [id])
  convertedPropertyId String?   @unique

  notes DealNote[]
  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([address])
}

// Parsed timeline from the "Latest Updates" mega-cell + manual notes going forward.
model DealNote {
  id        String    @id @default(cuid())
  deal      Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId    String
  noteDate  DateTime? // parsed date; null when the line had no clear date
  body      String    @db.Text
  source    String    @default("manual") // "migration" | "manual"
  createdAt DateTime  @default(now())

  @@index([dealId, noteDate])
}

// ---------------------------------------------------------------------------
// Properties — from the "Property Information" tab (~10 owned properties).
// ---------------------------------------------------------------------------
model Property {
  id      String @id @default(cuid())
  address String

  llcOwner     String? // plain text for now (HG Capital Partners LLC, HG Buffalo Holding 1/2 LLC, ...)
  refiTarget   String? // e.g. "-->HG3" from SREO
  attorney     String?
  lender       String? // Vontive / Conventus / ...
  loanServicer String? // Fay Servicing / FCI / ...

  status          String? // Rehabbing / Refinancing / Refinanced / Stabilized / Hold / Flip / Sold
  strategy        String? // Hold / Flip / BRRRR / Sell / TBD
  purchaseDate    DateTime?
  purchasePrice   Decimal?  @db.Decimal(12, 2)
  closingCosts    Decimal?  @db.Decimal(12, 2)
  refinanceDate   DateTime?
  currentLoan     Decimal?  @db.Decimal(12, 2)
  value           Decimal?  @db.Decimal(12, 2) // appraised / estimated
  replacementCost Decimal?  @db.Decimal(12, 2)
  rehabAmount     Decimal?  @db.Decimal(12, 2)
  rehabMonths     Decimal?  @db.Decimal(8, 2)
  sqft            Int?
  unitCount       Int?

  // Loan — flat, one current loan per property (refi history is a later model).
  loanNumber          String?
  loanType            String? // DSCR 30yr / Bridge / Portfolio / ... (src/lib/config.ts)
  loanOriginalAmount  Decimal?  @db.Decimal(12, 2)
  loanRate            Decimal?  @db.Decimal(6, 3)
  loanPaymentMonthly  Decimal?  @db.Decimal(12, 2)
  loanOriginationDate DateTime?
  loanMaturityDate    DateTime? // balloon / maturity — load-bearing
  loanEscrow          Boolean   @default(false)

  // Insurance — a lapse = lender force-places + technical default.
  insuranceCarrier     String?
  insurancePolicyNo    String?
  insuranceCoverage    Decimal?  @db.Decimal(12, 2)
  insuranceDeductible  Decimal?  @db.Decimal(12, 2)
  insuranceLiability   String? // free text, e.g. "1M / 2M"
  insurancePremium     Decimal?  @db.Decimal(12, 2)
  insuranceRenewalDate DateTime?

  // Other key dates (Buffalo: quarterly taxes — we track the next one).
  propertyTaxDueDate       DateTime?
  rentalRegistrationExpiry DateTime?

  // Per-unit reference data from "Property Information":
  // [{ label, lockboxCode, utilities: { nationalGridAcct, nationalGridAutopay, nationalGridLofl,
  //    nationalFuelAcct, nationalFuelAutopay, nationalFuelLofl, waterAcct, waterAutopay },
  //    equipment: [{ type, model, installYear }] }]
  units Json @default("[]")

  // Building-level major CapEx items, keyed by BUILDING_CAPEX_ITEMS[].key:
  // { roof: { year: "2010", costOverride: 27000 }, windows: { year: "2018" }, ... }
  buildingCapex Json @default("{}")

  notes String? @db.Text

  tasks       Task[]
  attachments PropertyAttachment[]
  sourceDeal  Deal?                @relation("DealToProperty")
  listings    Listing[]

  qboClasses  QboClass[]
  ledgerLines LedgerLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([address])
}

// ---------------------------------------------------------------------------
// Contacts — merged "Contractor Info" + "Contractor Contact Info" tabs.
// v1: contractors only. Bank/routing numbers are NEVER imported.
// ---------------------------------------------------------------------------
model Contact {
  id             String  @id @default(cuid())
  fullName       String
  company        String?
  trades         String? // "what they do"
  tenantFixes    Boolean @default(false)
  phone          String?
  email          String?
  mailingAddress String?
  billingInfo    String? // e.g. "Check", "Zelle" — no account numbers
  availability   String?
  w9Url          String?
  coiUrl         String?
  comments       String? @db.Text
  active         Boolean @default(true)

  phoneE164 String? // "+17165551234", for "Text login details"
  asanaGid  String? @unique // Asana user gid, matched once by the import

  qboVendors QboVendor[]

  // A contractor's portal login and what it can see (docs/asana-migration-plan.md §5.1).
  portalAccount       PortalAccount?
  taskAccess          TaskAccess[]
  assignedTasks       Task[]               @relation("TaskAssigneeContact")
  completedTasks      Task[]               @relation("TaskCompletedByContact")
  taskEvents          TaskEvent[]
  uploadedAttachments TaskAttachment[]     @relation("AttachmentUploadedByContact")
  checkedItems        TaskChecklistItem[]  @relation("ChecklistDoneByContact")
  taskReadStates      TaskReadState[]
  notifications       NotificationOutbox[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
}

// ---------------------------------------------------------------------------
// Tasks — from the Asana CSV export (~2,175 rows). Linked to a Property via
// the Asana section name where possible.
// ---------------------------------------------------------------------------
// Seven states (docs/asana-migration-plan.md D6). OPEN is shown as "To do";
// it keeps its old name so existing rows need no rewrite. Sort and filter by
// the explicit lists in src/lib/task-scope.ts, never by enum order: the new
// values were appended after DONE.
enum TaskStatus {
  OPEN
  DONE
  SCHEDULED
  IN_PROGRESS
  WAITING
  REVIEW
  CANCELED
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(OPEN)

  // Exactly one of these is set, or none (a CHECK in the migration enforces it).
  assignee          User?    @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  assigneeUserId    String?
  assigneeContact   Contact? @relation("TaskAssigneeContact", fields: [assigneeContactId], references: [id])
  assigneeContactId String?
  // Legacy free text from the CSV import. Display fallback only; assignment
  // goes through assigneeContactId now. Dropped once every row is mapped.
  assigneeName      String?
  assigneeEmail     String?

  dueDate      DateTime?
  startDate    DateTime?
  scheduledFor DateTime? // the booked visit date while SCHEDULED (UTC midnight, like dueDate)
  waitingOn    String? // the reason while WAITING: "city inspection", "gas co."
  unitLabel    String? // matches a Property.units[].label; picks the lockbox code
  priority     String?

  // Repeats: when done, the next copy is created (src/lib/tasks/repeat.ts).
  // { freq: "days" | "weeks" | "monthly" | "quarterly" | "yearly", interval: n, dayOfMonth?: 1-31 }
  repeatRule     Json?
  repeatSeriesId String?

  createdBy            User?    @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId      String?
  completedByUser      User?    @relation("TaskCompletedByUser", fields: [completedByUserId], references: [id], onDelete: SetNull)
  completedByUserId    String?
  completedByContact   Contact? @relation("TaskCompletedByContact", fields: [completedByContactId], references: [id], onDelete: SetNull)
  completedByContactId String?

  taskTemplate   TaskTemplate? @relation(fields: [taskTemplateId], references: [id], onDelete: SetNull)
  taskTemplateId String?

  // Asana sync (scripts/asana/*). appEditedAt is set only by app and portal
  // writes, never by @updatedAt, so the delta sync can tell app edits apart.
  appEditedAt     DateTime?
  asanaLastSynced Json? // the Asana field values as of the last sync, for a three-way merge
  asanaSyncedAt   DateTime?

  bucket     String  @default("Unfiled") // Property | General | Pieter properties | JMPL | Template | Unfiled
  sectionRaw String? // original Asana "Section/Column"
  tags       String?
  links      Json    @default("[]")

  asanaId String? @unique // idempotent re-import
  autoKey String? @unique // "<propertyId>:<slug>" — handle for auto-created key-date reminders

  deal       Deal?     @relation(fields: [dealId], references: [id])
  dealId     String?
  property   Property? @relation(fields: [propertyId], references: [id])
  propertyId String?

  attachments   TaskAttachment[]
  events        TaskEvent[]
  checklist     TaskChecklistItem[]
  access        TaskAccess[]
  readStates    TaskReadState[]
  notifications NotificationOutbox[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status])
  @@index([bucket])
  @@index([propertyId])
  @@index([dealId])
  @@index([assigneeContactId])
  @@index([repeatSeriesId])
}

// Who can see a comment, file or event: SHARED reaches the assigned
// contractor, INTERNAL is Connor and Pieter only. The database default is
// INTERNAL so anything written without a choice fails closed.
enum Visibility {
  SHARED
  INTERNAL
}

enum AttachmentKind {
  IMAGE
  VIDEO
  FILE
  LINK // a Dropbox/Drive/Box link from Asana; no bytes in Blob
}

// Files on a task. Bytes live in private Vercel Blob; this row keeps the
// metadata. Served only through /api/files/task/<id>, which checks who's asking.
model TaskAttachment {
  id          String         @id @default(cuid())
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  event       TaskEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId     String? // the comment it was posted with, if any
  url         String? // Blob URL; null for LINK
  pathname    String?        @unique // Blob pathname, needed to delete the blob; null for LINK
  linkUrl     String? // LINK only
  filename    String // original file name, shown to the user
  size        Int? // bytes; null for LINK
  contentType String?
  kind        AttachmentKind @default(FILE)
  visibility  Visibility     @default(INTERNAL)

  // At most one uploader (CHECK in the migration); neither for imported files
  // whose Asana uploader couldn't be matched.
  uploadedByUser      User?    @relation("AttachmentUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedByUserId    String?
  uploadedByContact   Contact? @relation("AttachmentUploadedByContact", fields: [uploadedByContactId], references: [id], onDelete: SetNull)
  uploadedByContactId String?
  // A staff upload's contractor: whoever was assigned when it was Shared. The
  // portal shows it to that contractor only, never to the next one on the
  // job (src/lib/portal/queries.ts). Null when no contractor was assigned. No
  // foreign key on purpose: if the contact is deleted the file stays theirs
  // instead of turning visible to everyone.
  audienceContactId   String?

  thumbPathname  String? // ~1024px JPEG, for grids
  posterPathname String? // a frame of a video
  width          Int?
  height         Int?
  durationSec    Float?

  asanaGid  String?   @unique
  deletedAt DateTime? // contractors only ever soft-delete
  createdAt DateTime  @default(now())

  @@index([taskId])
  @@index([eventId])
}

enum TaskEventKind {
  COMMENT
  CREATED
  ASSIGNED
  STATUS
  DUE
  SCHEDULED
  PROPERTY
  TITLE
  NOTES
  ATTACHMENT
  CHECKLIST
  ACCESS
  REPEAT_CREATED
  CONFLICT // the Asana delta sync and the app disagreed; see data
}

enum EventSource {
  APP // staff, in the app
  PORTAL // a contractor
  SYSTEM // reminders, the move-in form, repeats
  ASANA // imported story
}

// One timeline per task: comments, system changes and imported Asana stories.
// System kinds are always INTERNAL; the portal shows contractors a fixed
// allowlist (src/lib/portal/queries.ts).
model TaskEvent {
  id             String        @id @default(cuid())
  task           Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId         String
  kind           TaskEventKind
  visibility     Visibility    @default(INTERNAL)
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUserId    String?
  actorContact   Contact?      @relation(fields: [actorContactId], references: [id], onDelete: SetNull)
  actorContactId String?
  actorLabel     String // kept even if the person is later deleted: "Connor Swofford", "Zack (Outlaw Carpentry)", "Property reminder"
  // On a Shared staff or system event: the contractor assigned when it was
  // written, so a reply to Zack never reaches whoever gets the job next
  // (src/lib/portal/queries.ts). Null when no contractor was assigned, and on
  // contractor and imported rows. No foreign key, as on TaskAttachment.
  audienceContactId String?
  body           String?       @db.Text
  data           Json          @default("{}") // from/to values, imported HTML
  source         EventSource   @default(APP)
  asanaStoryGid  String?       @unique
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())

  attachments TaskAttachment[]

  @@index([taskId, createdAt])
}

// Checklist items (Asana subtasks become these). A table, not JSON: a
// contractor and a partner can tick items at the same time.
model TaskChecklistItem {
  id              String    @id @default(cuid())
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId          String
  title           String
  done            Boolean   @default(false)
  doneAt          DateTime?
  doneByUser      User?     @relation("ChecklistDoneByUser", fields: [doneByUserId], references: [id], onDelete: SetNull)
  doneByUserId    String?
  doneByContact   Contact?  @relation("ChecklistDoneByContact", fields: [doneByContactId], references: [id], onDelete: SetNull)
  doneByContactId String?
  assigneeLabel   String? // from an imported Asana subtask; display only
  dueDate         DateTime? // from an imported Asana subtask; display only
  position        Int       @default(0)
  asanaGid        String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([taskId, position])
}

// When each person last opened a task, for "2 new" badges. One row per
// (task, user) or (task, contact); a CHECK keeps exactly one of the two set.
model TaskReadState {
  id         String   @id @default(cuid())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId  String?
  lastSeenAt DateTime @default(now())

  @@unique([taskId, userId])
  @@unique([taskId, contactId])
}

// Playbooks (NEW TENANT, NEW REFI, ...). Items are edited as a whole list;
// order is array order.
// [{ title, notes?, assigneeUserId?, assigneeContactId?, dueOffsetDays? }]
model TaskTemplate {
  id                    String    @id @default(cuid())
  name                  String
  description           String?   @db.Text
  anchorLabel           String? // "Move-in date", "Closing date"; UI falls back to "Start date"
  items                 Json      @default("[]")
  sourceAsanaSectionGid String?   @unique
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tasks Task[]

  @@index([archivedAt])
}

// ---------------------------------------------------------------------------
// Contractor portal (docs/asana-migration-plan.md §5.1). Contractors are never
// User rows: every staff gate (requireUser) reads only the staff cookie, so a
// portal session can't open anything staff-only.
// ---------------------------------------------------------------------------

enum AccessSource {
  ASSIGNEE // created by assigning; revoked by reassigning
  MANUAL // shared by hand with an extra person
}

// Which contractor can see which task. canAccessTask() also requires an
// active PortalAccount, an active Contact and a live session.
model TaskAccess {
  id              String       @id @default(cuid())
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId          String
  contact         Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId       String
  source          AccessSource @default(ASSIGNEE)
  grantedBy       User?        @relation(fields: [grantedByUserId], references: [id], onDelete: SetNull)
  grantedByUserId String?
  createdAt       DateTime     @default(now())
  revokedAt       DateTime?

  @@unique([taskId, contactId])
  @@index([contactId])
}

enum PortalAccountStatus {
  ACTIVE
  DISABLED
}

model PortalAccount {
  id                 String              @id @default(cuid())
  contact            Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId          String              @unique
  // Lowercased. Never also a User email (checked in src/lib/portal/accounts.ts)
  // so /login knows which kind of account an address belongs to.
  email              String              @unique
  passwordHash       String // scrypt, same format as User.passwordHash (src/lib/password.ts)
  mustChangePassword Boolean             @default(true) // a starting password set by staff
  status             PortalAccountStatus @default(ACTIVE)
  createdBy          User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId    String?
  lastSignInAt       DateTime?
  lastSeenAt         DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  sessions    PortalSession[]
  resetTokens PasswordResetToken[]
}

// Database-backed so "Sign out everywhere" and "Remove access" take effect on
// the next request. The cookie holds a random token; only its hash is stored.
model PortalSession {
  id         String        @id @default(cuid())
  account    PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String
  tokenHash  String        @unique
  createdAt  DateTime      @default(now())
  lastUsedAt DateTime      @default(now())
  expiresAt  DateTime
  userAgent  String?
  revokedAt  DateTime?

  @@index([accountId])
}

model PasswordResetToken {
  id        String        @id @default(cuid())
  account   PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([accountId])
}

enum SecurityEventKind {
  SIGN_IN_OK
  SIGN_IN_FAILED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  SESSIONS_REVOKED
  ACCOUNT_CREATED
  ACCOUNT_DISABLED
  LOCKBOX_VIEWED
}

// Audit log for the portal. No foreign keys on purpose: it outlives the rows
// it mentions.
model SecurityEvent {
  id        String            @id @default(cuid())
  kind      SecurityEventKind
  userId    String?
  contactId String?
  taskId    String?
  data      Json              @default("{}")
  ipHash    String?
  createdAt DateTime          @default(now())

  @@index([createdAt])
  @@index([contactId, createdAt])
}

// Emails waiting to go out. Changes to one task for one recipient within a
// short window bundle into one row (and one email): openKey is set while the
// row is unsent and cleared when it's sent, so an upsert on it is atomic.
// Exactly one recipient (CHECK in the migration).
model NotificationOutbox {
  id                 String    @id @default(cuid())
  openKey            String?   @unique // "<u|c>:<recipientId>:<taskId>" while unsent
  recipientUser      User?     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientUserId    String?
  recipientContact   Contact?  @relation(fields: [recipientContactId], references: [id], onDelete: Cascade)
  recipientContactId String?
  task               Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId             String?
  items              Json      @default("[]") // [{ kind, actorLabel, summary, at }]
  firstAt            DateTime  @default(now())
  sendAfter          DateTime
  sentAt             DateTime?
  attempts           Int       @default(0)
  lastError          String?
  createdAt          DateTime  @default(now())

  @@index([sentAt, sendAfter])
}

// Documents uploaded to a property — same Vercel Blob pattern as TaskAttachment.
// PRIVATE: mortgage statements, insurance docs, etc. Never queried by the
// public site — see Listing.photoUrl below for the public-facing equivalent.
model PropertyAttachment {
  id          String   @id @default(cuid())
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String
  url         String
  pathname    String
  filename    String
  size        Int
  contentType String?
  createdAt   DateTime @default(now())

  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// Rentals — one row per marketable unit. Zillow stays the leasing system of
// record (PRD decision: don't duplicate the full listing there); this is just
// enough to render a card on the public /rentals page and link out to it.
// ---------------------------------------------------------------------------
enum ListingStatus {
  AVAILABLE
  LEASED // shown in "Previously Leased" for credibility, per the PRD
  HIDDEN // saved but not shown publicly (e.g. still being prepped)
}

model Listing {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  unitLabel String // free text — matches a Property.units[].label where possible, not FK'd
  zillowUrl String?

  rent  Decimal? @db.Decimal(10, 2)
  beds  String? // matches Deal.beds/baths — "2", "1.5", "Studio", etc.
  baths String?
  sqft  Int?

  availableDate DateTime?
  status        ListingStatus @default(HIDDEN)

  photos ListingPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([status])
}

// A listing's photo gallery — deliberately its own table, not
// PropertyAttachment: a public listing photo and a private mortgage
// statement must never share a table. sortOrder controls both the admin
// editor's left/right reorder and the public carousel's slide order; on
// save the whole set is replaced (full-replace, same convention as
// Property.units/buildingCapex), so a removed photo simply doesn't come back.
model ListingPhoto {
  id        String  @id @default(cuid())
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  url       String
  pathname  String
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([listingId])
}

// ---------------------------------------------------------------------------
// App configuration — a single row (id is always "singleton").
// Today: only the CapEx planning rules (age bands + replacement costs) edited
// at /settings. Built-in defaults live in src/lib/property-types.ts
// (DEFAULT_CAPEX_RULES); absence of this row == defaults.
// ---------------------------------------------------------------------------
model AppConfig {
  id               String   @id @default("singleton")
  capexRules       Json     @default("{}")
  moveInFormSchema Json     @default("{}")
  updatedAt        DateTime @updatedAt
  updatedBy        String? // user.name ?? user.email of the last editor
}

// ===========================================================================
// QuickBooks Online — read-only P&L mirror.
//
// Structure of HG's real company file (verified from exports):
//   - ONE company file, 5 entities (HGC, HG1, HG2, HG MGMT, BMK).
//   - Classes ON, hierarchical: parent = entity, child = "{ENTITY} {property}".
//   - Many classes -> one Property (properties move between LLCs on refi; the
//     management company carries operational lines). Classes partition the
//     ledger, so summing a property's classes never double-counts.
//   - Books start Jan 2026 (~a few hundred P&L lines).
//
// Sync = full-realm wipe-and-reinsert of LedgerLine from the ProfitAndLossDetail
// report (both bases), every run. Reclasses / voids / deletes self-heal.
// ===========================================================================

enum QboConnectionStatus {
  ACTIVE
  EXPIRED // token refresh failed / invalid_grant — UI shows "Reconnect"
  REVOKED // disconnected here or in Intuit
}

enum QboBasis {
  CASH
  ACCRUAL
}

enum QboClassRole {
  UNMAPPED // needs a human decision — pinned to the top of the settings table
  PROPERTY // resolves to exactly one Property
  ENTITY // a bare entity parent class ("HGC", "HG MGMT") — entity overhead
  OVERHEAD // an entity "* General" bucket — entity-level, not a property
  IGNORE // deliberately excluded from every rollup
}

// Fine-grained P&L line bucket — drives the expense-by-category bars + settings.
enum QboCategory {
  RENT
  OTHER_INCOME
  TAXES
  INSURANCE
  REPAIRS
  UTILITIES
  MANAGEMENT
  LEGAL_PROFESSIONAL
  LEASING_COMMISSION
  BANK_FEES
  SOFTWARE
  TRAVEL
  OTHER_OPEX
  DEBT_INTEREST
  UNCATEGORIZED
  CAPEX // balance-sheet; only appears if a GeneralLedger pull is added later
  INTERCOMPANY
  OWNER_EQUITY
  SUSPENSE // escrow / clearing parked in P&L (the $47,934 wire) — excluded from income
  EXCLUDED
  OTHER
}

// Coarse bucket that drives the NOI / cash-flow math.
enum QboTreatment {
  OPERATING_INCOME
  OPERATING_EXPENSE
  NON_OPERATING // bank interest income, owner-funded "rent"
  DEBT_INTEREST
  EXCLUDED // suspense, capex, principal, equity, intercompany, transfers
}

// Per-line signals the account category can't carry (owner P2P and Section-8
// both post to "Rents").
enum QboLineTag {
  OWNER_FUNDED // SCHWAB P2P from the owner, mis-booked to Rents
  SUBSIDY // Section-8 / HAP / HCV voucher rent (real tenant rent)
  INTERNAL_TRANSFER
  NEGATIVE_RECLASS // expense line < 0 — a real correction, kept and netted
  CAPEX_FLAG
}

enum QboSyncTrigger {
  INITIAL
  CRON
  MANUAL
}

enum QboSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL // reconciliation delta over tolerance, or the run bailed on its wall-budget
  FAILED
}

// One row. Child tables relate by realmId (@unique) so a reconnect of the same
// company upserts this row and mappings survive.
model QuickbooksConnection {
  id          String              @id @default(cuid())
  realmId     String              @unique
  environment String              @default("production") // "sandbox" | "production"
  status      QboConnectionStatus @default(ACTIVE)
  companyName String?

  // AES-256-GCM ciphertext (src/lib/quickbooks/crypto.ts). Never logged, never sent to the client.
  accessTokenEnc        String    @db.Text
  refreshTokenEnc       String    @db.Text
  prevRefreshTokenEnc   String?   @db.Text // one-shot fallback for the rotation half-write race
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  tokenRefreshedAt      DateTime?

  accountingMethod QboBasis @default(CASH) // the basis shown by default in the UI
  historyStart     String   @db.VarChar(7) // earliest usable month, "2026-01"

  connectedBy       User   @relation(fields: [connectedByUserId], references: [id])
  connectedByUserId String

  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  lastReconciledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities    QboEntity[]
  classes     QboClass[]
  accounts    QboAccount[]
  vendors     QboVendor[]
  ledgerLines LedgerLine[]
  syncRuns    QboSyncRun[]
}

// The 5 LLCs. Seeded from a static table, not discovered — the class hierarchy
// always carries the entity as the parent class.
model QboEntity {
  id         String               @id @default(cuid())
  realmId    String
  connection QuickbooksConnection @relation(fields: [realmId], references: [realmId], onDelete: Cascade)

  code           String // "HGC" | "HG1" | "HG2" | "HG MGMT" | "BMK"
  name           String // "HG Capital Partners LLC"
  llcOwnerNames  String[] @default([]) // Property.llcOwner strings that resolve here
  isJointVenture Boolean  @default(false) // BMK — 50/50 with partner "BK"
  sortOrder      Int      @default(0)

  classes     QboClass[]
  ledgerLines LedgerLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([realmId, code])
  @@index([realmId])
}

model QboClass {
  id         String               @id @default(cuid())
  realmId    String
  connection QuickbooksConnection @relation(fields: [realmId], references: [realmId], onDelete: Cascade)

  qboId              String
  name               String // leaf name, "HGC 15 Oxford"
  fullyQualifiedName String // "HGC:HGC 15 Oxford"
  parentQboId        String?
  isSubClass         Boolean @default(false)
  active             Boolean @default(true)

  role       QboClassRole @default(UNMAPPED)
  property   Property?    @relation(fields: [propertyId], references: [id])
  propertyId String? // many classes -> one property
  entity     QboEntity?   @relation(fields: [entityId], references: [id])
  entityId   String? // parent entity — set even for PROPERTY / UNMAPPED

  autoMatched   Boolean @default(false) // set by the matcher; any human edit clears it
  autoMatchNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([realmId, qboId])
  @@index([realmId, role])
  @@index([propertyId])
  @@index([entityId])
}

model QboAccount {
  id         String               @id @default(cuid())
  realmId    String
  connection QuickbooksConnection @relation(fields: [realmId], references: [realmId], onDelete: Cascade)

  qboId              String
  name               String
  fullyQualifiedName String
  acctType           String // Intuit AccountType: "Income" | "Expense" | "Other Income" | ...
  acctSubType        String?
  classification     String // "Revenue" | "Expense" | "Asset" | "Liability" | "Equity"
  active             Boolean @default(true)
  parentQboId        String?

  category       QboCategory  @default(OTHER)
  treatment      QboTreatment @default(EXCLUDED) // derived from category (+ interest-income override)
  categoryLocked Boolean      @default(false) // true once a human sets it, or the seed pins it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([realmId, qboId])
  @@index([realmId, category])
}

model QboVendor {
  id         String               @id @default(cuid())
  realmId    String
  connection QuickbooksConnection @relation(fields: [realmId], references: [realmId], onDelete: Cascade)

  qboId       String
  displayName String
  active      Boolean  @default(true)
  contact     Contact? @relation(fields: [contactId], references: [id])
  contactId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([realmId, qboId])
  @@index([contactId])
}

// One row per QuickBooks transaction line, per accounting basis. Rebuilt in full
// on every sync. Every resolved dimension is denormalized here so /financials
// views are plain groupBy — a re-map is an updateMany over these rows.
model LedgerLine {
  id         String               @id @default(cuid())
  realmId    String
  connection QuickbooksConnection @relation(fields: [realmId], references: [realmId], onDelete: Cascade)

  basis       QboBasis
  periodMonth String   @db.VarChar(7) // "2026-03"
  txnDate     DateTime @db.Date

  qboTxnId  String
  txnType   String // "Deposit" | "Expense" | "Journal Entry" | "Bill" | ...
  lineKey   String // "${qboTxnId}:${accountQboId}:${classKey}:${signedCents}:${ordinal}"
  docNumber String?

  name         String? // QBO "Name" (payee/customer), verbatim
  memo         String?
  businessName String? // QBO "Business"/Department column, verbatim (mismatch diagnostics)

  accountQboId   String
  accountName    String
  splitAccount   String? // "Item split account" — the contra side
  classification String
  category       QboCategory
  treatment      QboTreatment

  classKey  String // QboClass.qboId, or "__UNCLASSED__"
  className String?

  property   Property?    @relation(fields: [propertyId], references: [id])
  propertyId String?
  entity     QboEntity?   @relation(fields: [entityId], references: [id])
  entityId   String?
  classRole  QboClassRole @default(UNMAPPED)

  lineTags     QboLineTag[]
  vendorQboId  String?
  customerName String?

  amount Decimal @db.Decimal(14, 2) // signed, natural (income +, expense +, contra/reclass -)
  raw    Json

  syncRunId String?
  createdAt DateTime @default(now())

  @@unique([realmId, basis, lineKey])
  @@index([realmId, basis, periodMonth])
  @@index([propertyId, basis, periodMonth])
  @@index([entityId, basis, periodMonth])
  @@index([realmId, basis, treatment, periodMonth])
  @@index([realmId, basis, category, periodMonth])
  @@index([qboTxnId])
}

model QboSyncRun {
  id         String               @id @default(cuid())
  realmId    String
  connection QuickbooksConnection @relation(fields: [realmId], references: [realmId], onDelete: Cascade)

  trigger QboSyncTrigger
  status  QboSyncStatus  @default(RUNNING)

  startedAt   DateTime  @default(now())
  heartbeatAt DateTime  @default(now()) // row-based lock (pgbouncer kills advisory locks)
  finishedAt  DateTime?

  monthsProcessed Int     @default(0)
  stats           Json    @default("{}") // { reconciliation, dataQuality, counts, warnings }
  error           String? @db.Text

  @@index([realmId, startedAt])
  @@index([status, heartbeatAt])
}
