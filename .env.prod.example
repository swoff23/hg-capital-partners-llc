# Copy to .env.prod (gitignored). Lets `scripts/prod` and the health probe reach
# production for READ-ONLY debugging. See DEBUG.md for the CREATE ROLE script.

# Supabase → prod project → Connection string → "Session pooler" (port 5432),
# but with the read-only role's user/password, not `postgres`.
PROD_DATABASE_URL="postgresql://claude_ro:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Same value you set for HEALTH_TOKEN in the Vercel project env.
HEALTH_TOKEN=""

# Prod base URL for curl helpers.
PROD_URL="https://www.hgcapitalpartners.com"
