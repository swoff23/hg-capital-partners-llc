# Copy to .env for local dev. Never commit real values.

# Postgres connection string.
#   Local:  postgresql://<you>@localhost:5432/hg_capital_dev
#   Prod:   the connection string from your host's Postgres add-on
DATABASE_URL=""

# Random string (32+ chars) that signs the login cookie and the QuickBooks OAuth
# state. REQUIRED in production (the app refuses to sign sessions without it);
# leave blank locally and a dev-only secret is used. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Unlocks the detailed /api/health payload (migrations, Node version). Optional;
# without it the probe answers with the minimal shape. Same value goes in .env.prod.
HEALTH_TOKEN=""

# Sign-in now checks User.passwordHash in the DB, not these — see
# scripts/backfill-password-hashes.ts. Set one here only to seed a LOCAL test
# login: run `npx tsx scripts/backfill-password-hashes.ts` once after, and it
# hashes this value into your local dev DB (one-time; edit the User row
# directly, or clear passwordHash, to change it after that).
CONNOR_PASSWORD=""
PIETER_PASSWORD=""

# File uploads (task attachments). On Vercel: create a Blob store under the
# project's Storage tab and this is added automatically. For local uploads,
# run `vercel env pull` or paste the token here.
BLOB_READ_WRITE_TOKEN=""

# --- QuickBooks Online integration (Financials) — leave blank to disable ---
# Create an app at developer.intuit.com, add a redirect URI matching
# QBO_REDIRECT_URI below, and use the "Development" (sandbox) keys locally.
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_REDIRECT_URI="http://localhost:3000/api/quickbooks/callback"
QBO_ENVIRONMENT="sandbox" # sandbox | production
# 32 random bytes, base64 — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QBO_TOKEN_SECRET=""
# Optional: first month to pull history from ("YYYY-MM"). Defaults to 2026-01
# (when HG's QuickBooks books start) if unset.
QBO_HISTORY_START=""
# Guards GET /api/quickbooks/sync (the nightly cron). Any long random string —
# Vercel sends it automatically as `Authorization: Bearer $CRON_SECRET` on cron
# invocations. REQUIRED for the sync route to run at all (503 otherwise).
CRON_SECRET=""
