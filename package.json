{
  "name": "hg-capital-partners-llc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prebuild.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "check": "node scripts/check.mjs",
    "test:devices": "playwright test",
    "test:devices:known": "UPDATE_KNOWN_ISSUES=1 playwright test",
    "test:devices:dark": "DEVICES_SCHEME=dark playwright test",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:dev-passwords": "tsx --env-file=.env scripts/dev-reset-passwords.ts",
    "setup:worktree": "node scripts/setup-worktree.mjs",
    "migrate": "tsx scripts/migrate/run.ts",
    "trades:dry-run": "tsx --env-file=.env scripts/trades-dry-run.ts",
    "asana:snapshot": "tsx --env-file=.env scripts/asana/10-snapshot.ts",
    "asana:load": "tsx --env-file=.env scripts/asana/20-load.ts",
    "asana:delta": "tsx --env-file=.env scripts/asana/30-delta.ts",
    "asana:fixture": "tsx --env-file=.env scripts/asana/fixtures/make-fixture.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@sentry/browser": "11.10.0",
    "@sentry/nextjs": "11.10.0",
    "@tanstack/react-table": "^9.2.4",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.11",
    "class-variance-authority": "^0.7.1",
    "client-zip": "^2.5.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "heic-to": "^1.6.6",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "csv-parse": "^7.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "exceljs": "^4.4.0",
    "prisma": "^6.19.3",
    "shadcn": "4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "^5"
  },
  "volta": {
    "node": "24.22.3"
  }
}
