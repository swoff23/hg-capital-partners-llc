{
  "name": "hg-capital-partners-llc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prebuild.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "find src -name '*.test.ts' -print0 | xargs -0 tsx --test",
    "test:devices": "playwright test",
    "test:devices:known": "UPDATE_KNOWN_ISSUES=1 playwright test",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:dev-passwords": "tsx --env-file=.env scripts/dev-reset-passwords.ts",
    "migrate": "tsx scripts/migrate/run.ts",
    "asana:snapshot": "tsx --env-file=.env scripts/asana/10-snapshot.ts",
    "asana:load": "tsx --env-file=.env scripts/asana/20-load.ts",
    "asana:delta": "tsx --env-file=.env scripts/asana/30-delta.ts",
    "asana:fixture": "tsx --env-file=.env scripts/asana/fixtures/make-fixture.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-table": "^9.2.4",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "csv-parse": "^7.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "exceljs": "^4.4.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
