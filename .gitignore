# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.prod.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# HG — private source data & migration artifacts (never commit: contains PII, EINs, lockbox codes)
/_private/
# pg_dump backups (production data); keep them under _private/backups/
*.dump
/migration-archive/
/migration-report.md
*.xlsx
*.csv
*.docx

/src/generated/prisma

# Prisma generated client
/src/generated/

# Claude Code local settings
.claude/settings.local.json

# device check (npm run test:devices)
/.next-devices/
/device-report/

# Any other NEXT_DIST_DIR build (".next-live" and the like). Tailwind scans every
# file git doesn't ignore, and the binary caches inside break globals.css.
/.next-*/

# UI/UX review page with evidence screenshots (docs/uiux-review is the committed version).
# Kept out of git for the same reason as the device report: real tenant, loan and P&L figures.
/uiux-review/
/test-results/
/playwright-report/
